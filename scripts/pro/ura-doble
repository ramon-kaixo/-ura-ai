#!/usr/bin/env bash
# ura-doble — Puente de doble ventana para el Mac (2026-08-09)
# Conecta el OpenCode de escritorio (Mac) con el OpenCode Web (ASUS).
#
# Uso:
#   ura-doble sync        → sincroniza el repo del Mac con ASUS (git fetch + merge)
#   ura-doble status      → estado UDO real (vía SSH a ASUS — fuente de verdad)
#   ura-doble list [EST]  → tareas UDO (vía SSH a ASUS)
#   ura-doble verify TASK → verifica una tarea (vía SSH a ASUS)
#   ura-doble revisar     → SYNC + lista tareas que la Web terminó + estado
#   ura-doble ayuda       → este mensaje
#
# La fuente de verdad de los expedientes UDO está en ASUS; por eso ura-udo se
# ejecuta vía SSH. El repo local se sincroniza con git (fetch + merge ff-only).

set -euo pipefail

ASUS_HOST="${ASUS_HOST:-gx10}"   # alias SSH del Mac → ramon@10.164.1.99 (clave id_ed25519)
ASUS_USER="ramon"
ASUS_REPO="/home/ramon/URA/ura_ia_1972"
MAC_REPO="$HOME/URA/ura_ia_1972"
ASUS_UDO="ssh -o ConnectTimeout=8 gx10"

_ayuda() {
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

_sync() {
    echo "=== Sincronizando Mac ← ASUS ==="
    if [ ! -d "$MAC_REPO/.git" ]; then
        echo "ERROR: no hay repo en $MAC_REPO" >&2
        return 1
    fi
    cd "$MAC_REPO"
    if ! git remote | grep -q '^asus$'; then
        git remote add asus "$ASUS_USER@$ASUS_HOST:$ASUS_REPO"
        echo "remote 'asus' añadido"
    fi
    git fetch asus main 2>&1 | tail -1
    # Fast-forward si es posible; si las ramas divergen (Mac con commits propios
    # y ASUS con los suyos), se hace un merge real que combina ambos lados.
    if git merge --ff-only asus/main 2>/dev/null; then
        echo "✅ Repo del Mac al día con ASUS (fast-forward)"
    else
        echo "→ Ramas divergentes: fusionando cambios locales con ASUS..."
        if git merge asus/main --no-ff -m "merge: sync Mac con ASUS" 2>&1; then
            echo "✅ Merge completado — Mac y ASUS sincronizados"
        else
            echo "⚠️  Merge con conflictos. Resolver manualmente y commitear." >&2
        fi
    fi
}

_status() {
    echo "=== Estado UDO (ASUS — fuente de verdad) ==="
    $ASUS_UDO "$ASUS_REPO/scripts/pro/ura-udo" status
}

_list() {
    echo "=== Tareas UDO ==="
    $ASUS_UDO "$ASUS_REPO/scripts/pro/ura-udo" list "$@"
}

_verify() {
    [ -n "${1:-}" ] || { echo "Uso: ura-doble verify TASK-ID" >&2; return 1; }
    echo "=== Verify $1 (ASUS) ==="
    $ASUS_UDO "$ASUS_REPO/scripts/pro/ura-udo" verify "$1"
}

_revisar() {
    _sync
    echo ""
    echo "=== Tareas recientes (para revisar lo que hizo la Web) ==="
    $ASUS_UDO "$ASUS_REPO/scripts/pro/ura-udo" list REVIEW
    $ASUS_UDO "$ASUS_REPO/scripts/pro/ura-udo" list IN_PROGRESS
    echo ""
    echo "Consejo: ura-doble verify TASK-XXXX para ver qué cambió antes de revisar."
}

_quien() {
    echo "========== VENTANA 1 — OpenCode Web (ASUS) =========="
    echo "  Máquina:  $(ssh -o ConnectTimeout=5 gx10 hostname 2>/dev/null)"
    echo "  Proyecto: $(curl -s -u "ramon:***REDACTED***" http://10.164.1.99:8081/project/current 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('worktree','?'))" 2>/dev/null)"
    echo "  Cerebro:  deepseek-v4-flash (esta conversación)"
    echo ""
    echo "========== VENTANA 2 — OpenCode Escritorio (Mac) =========="
    echo "  Máquina:  $(hostname)"
    echo "  Proyecto: $(curl -s http://127.0.0.1:8091/project/current 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('worktree','?'))" 2>/dev/null)"
    echo "  Cerebro:  $(curl -s http://127.0.0.1:8091/config/providers 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('default',{}).get('ollama','?'))" 2>/dev/null) (Ollama local del Mac)"
    echo ""
    echo "Regla: la VENTANA 1 vive en ASUS (gx10) y usa DeepSeek; la VENTANA 2 vive en este Mac (Mini-de-RAMON) y usa Qwen 32B local."
}

case "${1:-}" in
    sync)    _sync ;;
    status)  _status ;;
    list)    shift; _list "$@" ;;
    verify)  shift; _verify "$@" ;;
    revisar) _revisar ;;
    quien)   _quien ;;
    ayuda|--help|-h) _ayuda ;;
    *) _ayuda; exit 1 ;;
esac
