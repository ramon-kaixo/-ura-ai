#!/bin/bash
# ura-udo — Capa mínima de coordinación UDO (F1 + F2)
# Uso: ura-udo create "desc" | show TASK-ID | update TASK-ID [--estado X] [--nota "…"] [--reserva "r1,r2"] [--force]
#      | reserve TASK-ID [--add "r1,r2"] [--clear] | check [ruta...]
#      | list [--estado] | status | verify TASK-ID | context TASK-ID
# Fuente de verdad: Git (código) + docs/udo/ (proceso). Sin BD, sin panel.

set -euo pipefail

UDO_ROOT="${UDO_ROOT:-$HOME/URA/ura_ia_1972/docs/udo}"
TASKS_DIR="$UDO_ROOT/tasks"
SEQ_FILE="$UDO_ROOT/.seq"
LOCK_FILE="$UDO_ROOT/.lock"
PENDIENTES_FILE="$UDO_ROOT/pendientes-fase.md"
REPO="${UDO_REPO:-$HOME/URA/ura_ia_1972}"

# bash 3.2 (Mac) no soporta arrays asociativos — lista separada por espacios.
# Compatible con bash 3.2 y 5.x (ASUS).
ESTADOS_VALIDOS="PLANNED IN_PROGRESS REVIEW DONE BLOCKED CONFLICT CANCELLED"
# Estados "activos": su reserva protege archivos frente a otras tareas
# (usado por check y por el enforcement de reservas en reserve/update)

_fecha()      { date +%Y-%m-%d; }
_fecha_hora() { date +%Y-%m-%dT%H:%M; }
_num()        { printf '%03d' "$1"; }

# --- ID único sin colisiones: contador global monotónico por fecha
_id_nuevo() {
    local hoy seq
    hoy="$(_fecha | tr -d '-')"
    seq=1
    if [ -f "$SEQ_FILE" ]; then
        seq=$(grep "^$hoy:" "$SEQ_FILE" 2>/dev/null | cut -d: -f2 || echo 0)
        seq=$((seq + 1))
    fi
    local tmp="${SEQ_FILE}.tmp.$$"
    (grep -v "^$hoy:" "$SEQ_FILE" 2>/dev/null || true; echo "$hoy:$seq") > "$tmp"
    mv "$tmp" "$SEQ_FILE"
    echo "TASK-$hoy-$(_num "$seq")"
}

_uso() {
    echo "Uso: ura-udo create \"desc\" | show TASK-ID | update TASK-ID [--estado X] [--nota \"…\"] [--reserva \"r1,r2\"] [--force] [--instrucciones …] [--restricciones …] [--revisor …] [--analisis …] [--validacion …]"
    echo "     | reserve TASK-ID [--add \"r1,r2\"] [--clear] | check [ruta...]"
    echo "     | list [--estado] | status | verify TASK-ID | context TASK-ID"
}

# --- Escritura con lock (ADR-002) para concurrencia segura.
# Espera hasta 30s (bloqueante) en lugar de fallar: Web y TERM compiten por
# escribir; con espera se serializan sin error espurio (carrera controlada).
# flock en Linux (ASUS); macOS no trae flock → shlock nativo (PID-based).
_udolock_cleanup() {
    [ "${UDO_LOCK:-}" = "1" ] && rm -f "$LOCK_FILE" 2>/dev/null || true
}
trap '_udolock_cleanup' EXIT

_lock() {
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$LOCK_FILE"
        flock -w 30 9 || { echo "ERROR: lock no disponible en 30s (otro proceso ura-udo activo)" >&2; exit 1; }
        return
    fi
    # macOS: shlock (lockfile con PID; reemplaza lock de procesos muertos).
    local i=0
    while ! shlock -f "$LOCK_FILE" -p $$ 2>/dev/null; do
        i=$((i+1))
        if [ "$i" -ge 30 ]; then
            echo "ERROR: lock no disponible en 30s (otro proceso ura-udo activo)" >&2
            exit 1
        fi
        sleep 1
    done
    UDO_LOCK=1
}

_ver_tarea() {
    local id="$1"
    [ -f "$TASKS_DIR/$id.md" ] || { echo "ERROR: tarea no encontrada: $id" >&2; exit 1; }
}

_estado() {
    grep '^estado:' "$TASKS_DIR/$1.md" | cut -d' ' -f2-
}

# --- _set_campo: actualiza o añade un campo. Los campos nuevos se insertan
# antes de la sección `historial:` (estructura canónica estable). Implementado
# con Python para ser portable (sed -i GNU/BSD difieren en Mac vs Linux).
_set_campo() {
    local id="$1" clave="$2" valor="$3" archivo="$TASKS_DIR/$id.md"
    python3 - "$archivo" "$clave" "$valor" <<'PYEOF'
import sys

archivo, clave, valor = sys.argv[1], sys.argv[2], sys.argv[3]
with open(archivo) as f:
    lineas = f.read().splitlines(True)

def salvar(nuevas):
    with open(archivo, "w") as f:
        f.writelines(nuevas)

prefijo = clave + ":"
for i, linea in enumerate(lineas):
    if linea.startswith(prefijo):
        lineas[i] = f"{clave}: {valor}\n"
        salvar(lineas)
        sys.exit(0)

for i, linea in enumerate(lineas):
    if linea.startswith("historial:"):
        lineas.insert(i, f"{clave}: {valor}\n")
        salvar(lineas)
        sys.exit(0)

lineas.append(f"{clave}: {valor}\n")
salvar(lineas)
PYEOF
}

# --- Reserva de una tarea como lista JSON-like: [ruta1, ruta2]
_reserva() {
    grep '^reserva:' "$TASKS_DIR/$1.md" 2>/dev/null | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true
}

_apuntar() {
    local id="$1" nota="$2" est="$3"
    echo "  - \"$(_fecha_hora) | ${est:-?} | $nota\"" >> "$TASKS_DIR/$id.md"
}

# --- Reservas activas (otras tareas distintas de la indicada): "TASK|ruta"
_reservas_activas_ajenas() {
    local self="$1"
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW)
                id_res=$(basename "$f" .md)
                [ "$id_res" = "$self" ] && continue
                res=$(grep '^reserva:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
                if [ -n "$res" ]; then
                    printf '%s|%s\n' "$id_res" "$res"
                fi
                ;;
        esac
    done
}

# --- Enforcement de reservas: rechaza declarar rutas reservadas por otra tarea
# activa (match exacto o prefijo dir/). Devuelve 1 si hay conflicto.
_conflicto_reserva() {
    local self="$1" rutas="$2" r area id_res owner
    rutas=$(printf '%s' "$rutas" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true)
    [ -n "$rutas" ] || return 0
    while IFS='|' read -r id_res area; do
        [ -n "$area" ] || continue
        area="${area%/}"
        # Owner del propietario de la reserva (F5 N7): agente con "(ejecutor)"
        owner=$(grep -E '^agente_(web|terminal): .*\(ejecutor\)' "$TASKS_DIR/$id_res.md" 2>/dev/null | head -1 | sed 's/^agente_\([a-z]*\): *\([^ ]*\).*/\1:\2/')
        [ -z "$owner" ] && owner="?"
        for r in $rutas; do
            if [[ "$r" == "$area" || "$r" == "$area/"* ]]; then
                echo "BLOQUEADO: '$r' — TASK=$id_res OWNER=$owner SCOPE=$area (reserva activa). Libera con reserve $id_res --clear o usa --force para autorización expresa." >&2
                return 1
            fi
        done
    done < <(_reservas_activas_ajenas "$self")
    return 0
}

# --- Gate de integridad de revisión (F2.2, al cerrar DONE): exige que la
# revisión signifique algo. Ejecuta solo sin --force.
    _gate_revision() {
    local id="$1" file="$TASKS_DIR/$1.md" base commits tocados sha r sucio
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    if [ -z "$base" ] || [ "$base" = "unknown" ]; then
        echo "ERROR: DONE requiere commit_base (¿tarea nunca fue IN_PROGRESS?)" >&2
        return 1
    fi
    commits=$(grep '^commits:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
    if [ -z "$commits" ]; then
        echo "ERROR: DONE requiere commits registrados — ejecuta 'ura-udo verify TASK' antes de cerrar" >&2
        return 1
    fi
    tocados=$(git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null || true)
    tocados=$( { echo "$tocados"; git -C "$REPO" status --porcelain | sed 's/^...//'; } | sed 's/^ *//' | grep -v '^$' | grep -v '^docs/udo/\(tasks\|\.seq\)' | sort -u || true )
    if [ -z "$tocados" ]; then
        echo "ERROR: DONE sin trabajo revisable (diff commit_base..HEAD vacío y árbol limpio)" >&2
        return 1
    fi
    local IFS=$'\n'
    # H1 fix (TASK-20260812-003): los mensajes de commit pueden contener comas,
    # por lo que separar por ',' rompe la lista. Se extraen los SHAs candidatos
    # (hex 7-40) del campo commits: y se verifica cada uno con git rev-parse
    # (descarta falsos positivos tipo TASK-20260811-003, que no son commits).
    for sha in $(echo "$commits" | grep -oE '[0-9a-f]{7,40}' || true); do
        if ! git -C "$REPO" rev-parse --verify --quiet "$sha"^{commit} >/dev/null 2>&1; then
            continue
        fi
        if ! git -C "$REPO" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
            echo "ERROR: DONE bloqueado — commit '$sha' no es ancestro de HEAD (historia reescrita tras verificación)" >&2
            return 1
        fi
    done
    sucio=$(git -C "$REPO" status --porcelain | grep -v '^??' | sed 's/^...//' | grep -v '^docs/udo/\(tasks\|\.seq\)' || true)
    if [ -n "$sucio" ]; then
        echo "ERROR: DONE bloqueado — cambios sin commitear fuera del expediente:" >&2
        echo "$sucio" | sed 's/^/  /' >&2
        return 1
    fi
    # Requisitos de análisis y validación (PLAN 1, A1/A2): la regla central
    # del Plan 0 exige análisis previo; la trazabilidad exige validación.
    # Al final del gate (prioridad a los mensajes F2.2). Solo para tareas
    # post-parche (campo analisis: presente). Pre-parche: verify INFO (X2).
    if grep -q '^analisis:' "$file"; then
        an=$(grep '^analisis:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        va=$(grep '^validacion:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        if [ -z "$an" ] || [ "$an" = "—" ]; then
            echo "ERROR: DONE requiere analisis — usa 'update $id --analisis \"...\"' (PLAN 1 A1)" >&2
            return 1
        fi
        if [ -z "$va" ] || [ "$va" = "—" ]; then
            echo "ERROR: DONE requiere validacion — usa 'update $id --validacion \"...\"' (PLAN 1 A2)" >&2
            return 1
        fi
    fi
    # Verificación REAL (V1 — auditoría TASK-20260809-012): si el expediente
    # tiene comando de verificación (verificar:), el gate lo EJECUTA antes de
    # permitir DONE. Así "digo que pasa" se convierte en "la máquina lo
    # comprueba". Si el comando falla, el cierre se bloquea.
    vcmd=$(grep '^verificar:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
    if [ -n "$vcmd" ] && [ "$vcmd" != "—" ]; then
        echo "Ejecutando verificación real: $vcmd"
        if ! (cd "$REPO" && eval "$vcmd") > /tmp/udo_verificar_$$.log 2>&1; then
            echo "ERROR: DONE bloqueado — la verificación FALLÓ:" >&2
            cat /tmp/udo_verificar_$$.log | tail -10 | sed 's/^/  /' >&2
            rm -f /tmp/udo_verificar_$$.log
            return 1
        fi
        rm -f /tmp/udo_verificar_$$.log
        echo "Verificación real: OK"
    fi
    # Requisitos del plan (V2): si hay algún [ ] pendiente, el DONE se bloquea.
    req=$(grep '^requisitos:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
    if [ -n "$req" ]; then
        pend=$(echo "$req" | tr ';' '\n' | grep -c '\[ \]' || true)
        if [ "${pend:-0}" -gt 0 ]; then
            echo "ERROR: DONE bloqueado — ${pend} requisito(s) del plan sin completar:" >&2
            echo "$req" | tr ';' '\n' | grep '\[ \]' | sed 's/^/  - /' >&2
            echo "Marcar como hecho: ura-udo update $id --requisito-hecho \"texto del requisito\"" >&2
            return 1
        fi
    fi
    return 0
}

# --- Determina si el cierre es auto-revisión: revisor vacío o == ejecutor.
_es_auto_revision() {
    local id="$1" revisor="$2" ejecutor="" campo v
    if [ -z "$revisor" ]; then
        return 0
    fi
    for campo in agente_web agente_terminal; do
        v=$(grep "^$campo: " "$TASKS_DIR/$id.md" | cut -d' ' -f2- || true)
        case "$v" in
            *"(ejecutor)"*) ejecutor="${v%% (ejecutor)*}"; break ;;
        esac
    done
    [ -n "$ejecutor" ] && [ "$revisor" = "$ejecutor" ]
}

case "${1:-}" in

  create)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _lock
    id="$(_id_nuevo)"
    file="$TASKS_DIR/$id.md"
    {
        echo "---"
        echo "id: $id"
        echo "fecha: $(_fecha)"
        echo "solicitante: ${URA_SOLICITANTE:-RAMON}"
        echo "descripcion: $2"
        echo "objetivo: "
        echo "instrucciones: "
        echo "restricciones: "
        echo "estado: PLANNED"
        echo "canal: ${URA_SOLICITANTE:-RAMON}"
        echo "agente_web: "
        echo "agente_terminal: "
        echo "revisor: "
        echo "reserva: []"
        echo "commit_base: "
        echo "contexto: "
        echo "cambios: []"
        echo "commits: []"
        echo "analisis: "
        echo "validacion: "
        echo "verificar: "
        echo "requisitos: "
        echo "pendientes: []"
        echo "resultado: "
        echo "resultado_web: "
        echo "resultado_terminal: "
        echo "revision: "
        echo "pendientes: []"
        echo "resultado: "
        echo "historial:"
        echo "  - \"$(_fecha_hora) | PLANNED | creada\""
        echo "---"
    } > "$file"
    echo "Creada: $id -> $file"
    ;;

  show)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    cat "$TASKS_DIR/$2.md"
    ;;

  context)
    # Contexto compartido (F2): expediente + últimos commits + reservas activas
    # que puedan afectar a la zona. Recuperable aunque el otro agente esté idle
    # (fuente de verdad: Git + expediente, no la conversación).
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"
    file="$TASKS_DIR/$id.md"
    echo "=== CONTEXTO UDO — $id ==="
    echo "ID: $id"
    echo "Estado: $(_estado "$id")"
    grep -E '^(descripcion|objetivo|instrucciones|restricciones|canal|agente_web|agente_terminal|revisor|reserva|commit_base|contexto|resultado|pendientes):' "$file" | sed 's/^/  /'
    echo "--- Últimos commits ---"
    git -C "$REPO" log --oneline --grep="$id" -5 2>/dev/null || true
    echo "--- Reservas activas que afectan ---"
    "$0" check 2>/dev/null | head -10 || true
    echo "--- Historial (últimas 5) ---"
    grep -A 5 '^historial:' "$file" | head -6 | sed 's/^/  /'
    ;;

  update)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; estado="" nota="" reserva="" reserva_flag="" agente_web_val="" agente_terminal_val="" instrucciones_val="" restricciones_val="" revisor_val="" analisis_val="" validacion_val="" verificar_val="" requisito_add="" requisito_hecho="" pendientes_val="" resultado_val="" resultado_web_val="" resultado_terminal_val="" force=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --estado)  estado="${2:-}"; shift 2 ;;
            --nota)    nota="${2:-}"; shift 2 ;;
            --reserva) reserva_flag=1; reserva="${2:-}"; shift 2 ;;
            --agente_web)      agente_web_val="${2:-}"; shift 2 ;;
            --agente_terminal) agente_terminal_val="${2:-}"; shift 2 ;;
            --instrucciones)   instrucciones_val="${2:-}"; shift 2 ;;
            --restricciones)   restricciones_val="${2:-}"; shift 2 ;;
            --revisor)         revisor_val="${2:-}"; shift 2 ;;
            --analisis)        analisis_val="${2:-}"; shift 2 ;;
            --validacion)      validacion_val="${2:-}"; shift 2 ;;
            --verificar)       verificar_val="${2:-}"; shift 2 ;;
            --requisito)       requisito_add="${requisito_add:+$requisito_add;}${2:-}"; shift 2 ;;
            --requisito-hecho) requisito_hecho="${requisito_hecho:+$requisito_hecho;}${2:-}"; shift 2 ;;
            --pendientes)      pendientes_val="${2:-}"; shift 2 ;;
            --resultado)       resultado_val="${2:-}"; shift 2 ;;
            --resultado_web)   resultado_web_val="${2:-}"; shift 2 ;;
            --resultado_terminal) resultado_terminal_val="${2:-}"; shift 2 ;;
            --force)   force=1; shift ;;
            *) echo "ERROR: argumento desconocido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    file="$TASKS_DIR/$id.md"
    est_actual=$(_estado "$id")
    if [ -n "$estado" ]; then
        if ! [[ " $ESTADOS_VALIDOS " == *" $estado "* ]]; then
            echo "ERROR: estado inválido '$estado' (válidos: $ESTADOS_VALIDOS)" >&2
            exit 1
        fi
        # Regla de integridad (F2, CASO B): DONE solo desde REVIEW — sin
        # revisión válida previa, la tarea no puede cerrarse. Excepción:
        # --force explícito con nota (autorización expresa, queda auditada).
        if [ "$estado" = "DONE" ] && [ "$est_actual" != "REVIEW" ] && [ -z "$force" ]; then
            echo "ERROR: DONE solo desde REVIEW (revisión previa requerida — CASO B). Usa --force si es una excepción explícita." >&2
            exit 1
        fi
        # Gate de integridad de revisión (F2.2): al cerrar DONE sin --force,
        # la revisión debe significar algo (commits registrados, diff no vacío,
        # SHAs ancestrales, árbol limpio fuera del expediente).
        if [ "$estado" = "DONE" ] && [ -z "$force" ]; then
            # PLAN 1 A1/A2: los campos analisis/validacion deben persistirse
            # antes de que el gate los compruebe (el gate corre con el
            # expediente ya actualizado).
            if [ -n "$analisis_val" ]; then
                _set_campo "$id" "analisis" "$analisis_val"
            fi
            if [ -n "$validacion_val" ]; then
                _set_campo "$id" "validacion" "$validacion_val"
            fi
            if [ -n "$verificar_val" ]; then
                _set_campo "$id" "verificar" "$verificar_val"
            fi
            _gate_revision "$id" || exit 1
        fi
        _set_campo "$id" "estado" "$estado"
        hist="$est_actual -> $estado${nota:+ — $nota}"
        if [ "$estado" = "DONE" ] && [ "$est_actual" != "REVIEW" ] && [ -n "$force" ]; then
            hist="${hist} — AUTORIZACIÓN EXPRESA (--force)"
        fi
        # Marca honesta de auto-revisión (F2.2): la dice la herramienta, no el
        # texto libre. Revisor vacío o igual al ejecutor = AUTO-REVISIÓN.
        if [ "$estado" = "DONE" ]; then
            if _es_auto_revision "$id" "${revisor_val:-}"; then
                hist="${hist} — AUTO-REVISIÓN${revisor_val:+ (revisor=$revisor_val)}"
            elif [ -n "$revisor_val" ]; then
                _set_campo "$id" "revisor" "$revisor_val"
                hist="${hist} — revisión por $revisor_val"
            fi
        elif [ -n "$revisor_val" ]; then
            _set_campo "$id" "revisor" "$revisor_val"
        fi
    else
        hist="$nota"
    fi
    # Auto-registro del commit base: al comenzar IN_PROGRESS, o si falta en
    # una tarea ya en IN_PROGRESS (compatibilidad con tareas pre-F2)
    if [ "$est_actual" = "IN_PROGRESS" ] || [ "$estado" = "IN_PROGRESS" ]; then
        if [ -z "$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)" ]; then
            base=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            _set_campo "$id" "commit_base" "$base"
        fi
    fi
    if [ -n "$reserva" ]; then
        # Enforcement (F2): no declarar rutas reservadas por otra tarea activa
        # --force = autorización expresa (queda en historial como excepción)
        if [ -z "$force" ]; then
            _conflicto_reserva "$id" "$reserva" || exit 1
        else
            hist="${hist:+$hist — }AUTORIZACIÓN EXPRESA (--force) sobre: $reserva"
        fi
        _set_campo "$id" "reserva" "[$reserva]"
        hist="${hist:+$hist — }reserva: [$reserva]"
    elif [ -n "${reserva_flag:-}" ]; then
        _set_campo "$id" "reserva" "[]"
        hist="${hist:+$hist — }reserva: []"
    fi
    if [ -n "$agente_web_val" ]; then
        _set_campo "$id" "agente_web" "$agente_web_val"
        hist="${hist:+$hist — }agente_web: $agente_web_val"
    fi
    if [ -n "$agente_terminal_val" ]; then
        _set_campo "$id" "agente_terminal" "$agente_terminal_val"
        hist="${hist:+$hist — }agente_terminal: $agente_terminal_val"
    fi
    if [ -n "$instrucciones_val" ]; then
        _set_campo "$id" "instrucciones" "$instrucciones_val"
        hist="${hist:+$hist — }instrucciones: $instrucciones_val"
    fi
    if [ -n "$restricciones_val" ]; then
        _set_campo "$id" "restricciones" "$restricciones_val"
        hist="${hist:+$hist — }restricciones: $restricciones_val"
    fi
    if [ -n "$analisis_val" ]; then
        _set_campo "$id" "analisis" "$analisis_val"
        hist="${hist:+$hist — }analisis registrado"
    fi
    if [ -n "$validacion_val" ]; then
        _set_campo "$id" "validacion" "$validacion_val"
        hist="${hist:+$hist — }validacion registrada"
    fi
    if [ -n "$verificar_val" ]; then
        _set_campo "$id" "verificar" "$verificar_val"
        hist="${hist:+$hist — }verificación real registrada: $verificar_val"
    fi
    # Requisitos del plan (V2): lista con [x]/[ ] separada por ";"
    if [ -n "$requisito_add" ]; then
        actual=$(grep '^requisitos:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        nuevos=""
        IFS=';' read -ra REQS <<< "$requisito_add"
        for r in "${REQS[@]}"; do
            [ -n "$r" ] || continue
            nuevos="${nuevos:+$nuevos; }[ ] $r"
        done
        if [ -n "$actual" ]; then
            _set_campo "$id" "requisitos" "$actual; $nuevos"
        else
            _set_campo "$id" "requisitos" "$nuevos"
        fi
        hist="${hist:+$hist — }requisito(s) añadido(s): $requisito_add"
    fi
    if [ -n "$requisito_hecho" ]; then
        actual=$(grep '^requisitos:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        # Marca como [x] cada requisito que coincida (lista separada por ;)
        python3 - "$file" "$requisito_hecho" <<'PYEOF'
import sys
path, textos = sys.argv[1], sys.argv[2]
textos = [t.strip() for t in textos.split(";") if t.strip()]
lines = open(path).read().split("\n")
for i, line in enumerate(lines):
    if line.startswith("requisitos:"):
        val = line.split("requisitos:", 1)[1].strip()
        items = [it.strip() for it in val.split(";")]
        nuevos = []
        for it in items:
            marcado = False
            for t in textos:
                if it.startswith("[ ]") and t in it:
                    nuevos.append("[x]" + it[3:])
                    marcado = True
                    break
            if not marcado:
                nuevos.append(it)
        lines[i] = "requisitos: " + "; ".join(nuevos)
        break
open(path, "w").write("\n".join(lines))
PYEOF
        hist="${hist:+$hist — }requisito(s) marcado(s) hecho: $requisito_hecho"
    fi
    if [ -n "$pendientes_val" ]; then
        _set_campo "$id" "pendientes" "$pendientes_val"
        hist="${hist:+$hist — }pendientes: $pendientes_val"
    fi
    if [ -n "$resultado_val" ]; then
        _set_campo "$id" "resultado" "$resultado_val"
        hist="${hist:+$hist — }resultado registrado"
    fi
    if [ -n "$resultado_web_val" ]; then
        _set_campo "$id" "resultado_web" "$resultado_web_val"
        hist="${hist:+$hist — }resultado_web registrado"
    fi
    if [ -n "$resultado_terminal_val" ]; then
        _set_campo "$id" "resultado_terminal" "$resultado_terminal_val"
        hist="${hist:+$hist — }resultado_terminal registrado"
    fi
    if [ -n "$hist" ]; then
        _apuntar "$id" "$hist" "${estado:-$est_actual}"
    fi
    echo "Actualizada: $id (estado: ${estado:-$est_actual})"
    ;;

  reserve)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; accion="" ruta="" force=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --add)   accion="add";   ruta="${2:-}"; shift 2 ;;
            --clear) accion="clear"; shift ;;
            --force) force=1; shift ;;
            *) echo "ERROR: argumento no válido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    actual=$(_reserva "$id")
    if [ "$accion" = "clear" ]; then
        nueva=""
    elif [ "$accion" = "add" ] && [ -n "$ruta" ]; then
        # Enforcement (F2): no reservar rutas ya reservadas por otra tarea activa
        if [ -z "$force" ]; then
            _conflicto_reserva "$id" "$ruta" || exit 1
        fi
        [ -n "$actual" ] && nueva="$actual, $ruta" || nueva="$ruta"
    else
        echo "Reserva actual de $id: [$actual]"
        exit 0
    fi
    _set_campo "$id" "reserva" "[$nueva]"
    if [ -n "$force" ] && [ "$accion" = "add" ]; then
        _apuntar "$id" "reserva: [$nueva] (AUTORIZACIÓN EXPRESA --force)" "$(_estado "$id")"
    else
        _apuntar "$id" "reserva: [$nueva]" "$(_estado "$id")"
    fi
    echo "Reserva de $id: [$nueva]"
    ;;

  check)
    # check sin rutas: lista las reservas activas (IN_PROGRESS/REVIEW)
    # check con rutas: detector de conflicto frente a las reservas activas
    shift
    keys=()
    while IFS= read -r f; do
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW)
                res=$(grep '^reserva:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true)
                if [ -n "$res" ]; then
                    while IFS= read -r r; do
                        keys+=("$(basename "$f" .md)|$r")
                    done <<< "$res"
                fi
                ;;
        esac
    done < <(ls "$TASKS_DIR"/*.md 2>/dev/null || true)

    if [ $# -eq 0 ]; then
        if [ ${#keys[@]} -eq 0 ]; then
            echo "Sin reservas activas."
        else
            echo "Reservas activas:"
            printf '  %s\n' "${keys[@]}"
        fi
        exit 0
    fi
    # conflicto contra rutas dadas (args restantes tras shift)
    conflicto=0
    for ruta in "$@"; do
        for k in "${keys[@]}"; do
            id_res="${k%%|*}"; area="${k#*|}"
            if [[ "$ruta" == "$area" || "$ruta" == "$area/"* ]]; then
                echo "CONFLICTO: '$ruta' está reservada por $id_res ($area)"
                conflicto=1
            fi
        done
    done
    if [ "$conflicto" -eq 0 ]; then
        echo "OK: ninguna ruta colisiona con reservas activas. Tomando: $*"
    fi
    exit 0
    ;;

  list)
    filtro="${2:-}"
    echo "=== TAREAS ==="
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        if [ -n "$filtro" ]; then
            [ "$est" = "$filtro" ] || continue
        fi
        echo "  $(basename "$f" .md) [$est]"
    done | grep -v '^$'
    ;;

  status)
    echo "=== UDO — estado del proyecto ==="
    # F5 N1: por cada tarea activa (IN_PROGRESS/REVIEW/BLOCKED/CONFLICT) muestra
    # TASK, estado, owner, última actividad, commits, pendientes (§5.10).
    echo "--- En curso ---"
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW|BLOCKED|CONFLICT)
                idt=$(basename "$f" .md)
                # Owner: agente con "(ejecutor)" (Web o TERM)
                owner=$(grep -E '^agente_(web|terminal): .*\(ejecutor\)' "$f" | head -1 | sed 's/^agente_\([a-z]*\): *\([^ ]*\).*/\1:\2/')
                [ -z "$owner" ] && owner="?"
                # Última actividad: última línea del historial
                ultima=$(grep '^  - ' "$f" | tail -1 | sed 's/^  - "//; s/"$//' || echo "?")
                # Commits: campo commits:
                comm=$(grep '^commits:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || echo "—")
                # Pendientes: campo pendientes:
                pend=$(grep '^pendientes:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || echo "—")
                echo "  TASK: $idt | estado: $est | owner: $owner"
                echo "    última actividad: $ultima"
                echo "    commits: ${comm:-—}"
                echo "    pendientes: ${pend:-—}"
                ;;
        esac
    done
    echo "--- Bloqueadas ---"
    "$0" list BLOCKED
    echo "--- Reservas activas ---"
    "$0" check
    echo "--- Últimos commits ---"
    git -C "$REPO" log --oneline -5
    ;;

  revisar)
    # Veredicto estructurado del revisor (F2.3): un plan/fase NO se cierra
    # hasta que el revisor da OK. El veredicto queda en el campo revision:
    # con formato canónico (auditable), no solo en notas.
    # Uso: revisar TASK --ok "nota" | revisar TASK --devolver "motivo del fallo"
    id="$2"
    [ -n "$id" ] || { echo "Uso: ura-udo revisar TASK --ok \"nota\" | --devolver \"motivo\"" >&2; exit 1; }
    _ver_tarea "$id"
    file="$TASKS_DIR/$id.md"
    veredicto="${3:-}"
    nota="${4:-}"
    case "$veredicto" in
      --ok)
        [ -n "$nota" ] || { echo "Uso: revisar TASK --ok \"nota del revisor\"" >&2; exit 1; }
        _lock
        # V3: el OK del revisor debe COMPROBAR, no solo declarar. Si la tarea
        # tiene verificación real (verificar:), se ejecuta aquí también —
        # si falla, el OK se rechaza (el revisor no puede aprobar algo que
        # no pasa la comprobación).
        vcmd=$(grep '^verificar:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        if [ -n "$vcmd" ] && [ "$vcmd" != "—" ]; then
            echo "Revisor: ejecutando verificación real ($vcmd)..."
            if ! (cd "$REPO" && eval "$vcmd") > /tmp/udo_revisar_$$.log 2>&1; then
                echo "ERROR: OK RECHAZADO — la verificación falló al revisar:" >&2
                cat /tmp/udo_revisar_$$.log | tail -10 | sed 's/^/  /' >&2
                rm -f /tmp/udo_revisar_$$.log
                exit 1
            fi
            rm -f /tmp/udo_revisar_$$.log
            echo "Verificación real: OK (revisor)"
        fi
        # V3: detecta auto-revisión — si el revisor es el mismo que el
        # ejecutor, el veredicto queda marcado como AUTO-REVISIÓN (honesto).
        auto=""
        if _es_auto_revision "$id" "${URA_REVISOR:-}"; then
            auto=" | AUTO-REVISIÓN"
        fi
        rev="$(_fecha_hora) | OK | $nota${URA_REVISOR:+ | revisor=$URA_REVISOR}$auto"
        _set_campo "$id" "revision" "$rev"
        _set_campo "$id" "estado" "REVIEW"
        hist="REVISION OK — $nota${URA_REVISOR:+ (revisor=$URA_REVISOR)}${auto:+ (AUTO-REVISIÓN)}"
        _apuntar "$id" "$hist" "REVIEW"
        echo "Revisión OK registrada: $id — queda en REVIEW (puede cerrarse con DONE + gate)"
        ;;
      --devolver)
        [ -n "$nota" ] || { echo "Uso: revisar TASK --devolver \"motivo del fallo\"" >&2; exit 1; }
        _lock
        # El revisor encuentra fallo: devuelve al ejecutor (IN_PROGRESS).
        # El ejecutor NO es quien arregla la revisión — el revisor solo juzga.
        rev="$(_fecha_hora) | DEVUELTA | $nota${URA_REVISOR:+ | revisor=$URA_REVISOR}"
        _set_campo "$id" "revision" "$rev"
        _set_campo "$id" "estado" "IN_PROGRESS"
        hist="REVISIÓN DEVUELTA — $nota${URA_REVISOR:+ (revisor=$URA_REVISOR)}"
        _apuntar "$id" "$hist" "IN_PROGRESS"
        echo "Revisión devuelta: $id — vuelve a IN_PROGRESS (el ejecutor corrige y reenvía a REVIEW)"
        ;;
      *)
        echo "Uso: ura-udo revisar TASK --ok \"nota\" | --devolver \"motivo\"" >&2
        exit 1
        ;;
    esac
    ;;

  pendientes)
    # Cola de pendientes de fase (TASK-20260809-011): un pendiente puede
    # posponerse (cola) sin bloquear el avance, pero la fase NO se cierra
    # hasta que la cola esté resuelta o justificada por Ramón.
    # Uso: pendientes add TASK-ID "texto" | pendientes list | pendientes resolver TASK-ID "nota" | pendientes check
    accion="${2:-}"
    case "$accion" in
      add)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "Uso: ura-udo pendientes add TASK-ID \"texto pendiente\"" >&2; exit 1; }
        _lock
        mkdir -p "$(dirname "$PENDIENTES_FILE")"
        if [ ! -f "$PENDIENTES_FILE" ]; then
            cat > "$PENDIENTES_FILE" <<'HEADER'
# Cola de pendientes de fase

Los pendientes de un plan pueden posponerse (cola) sin bloquear el avance a
la siguiente fase, PERO la fase NO se cierra hasta que la cola esté resuelta
o justificada por Ramón. Cada fila: TASK | pendiente | fecha | estado | resolución.

| TASK | Pendiente | Fecha | Estado | Resolución |
|------|-----------|-------|--------|------------|
HEADER
        fi
        fecha=$(_fecha)
        printf '| %s | %s | %s | ABIERTO | — |\n' "$3" "$4" "$fecha" >> "$PENDIENTES_FILE"
        echo "Pendiente registrado: $3 — $4"
        ;;
      list)
        [ -f "$PENDIENTES_FILE" ] || { echo "Cola vacía (sin pendientes registrados)."; exit 0; }
        abiertos=$(grep -c "| ABIERTO |" "$PENDIENTES_FILE" || true)
        echo "=== Cola de pendientes de fase ==="
        cat "$PENDIENTES_FILE"
        echo ""
        echo "Abiertos: ${abiertos:-0}"
        ;;
      resolver)
        [ -n "${3:-}" ] && [ -n "${4:-}" ] || { echo "Uso: ura-udo pendientes resolver TASK-ID \"nota de resolución\"" >&2; exit 1; }
        _lock
        [ -f "$PENDIENTES_FILE" ] || { echo "ERROR: no hay cola" >&2; exit 1; }
        # Marca como resuelta la primera fila ABIERTO de esa TASK
        if grep -q "| $3 | .*| ABIERTO |" "$PENDIENTES_FILE"; then
            python3 - "$PENDIENTES_FILE" "$3" "$4" <<'PYEOF'
import sys
path, task, nota = sys.argv[1], sys.argv[2], sys.argv[3]
lines = open(path).read().split("\n")
for i, line in enumerate(lines):
    if f"| {task} |" in line and "| ABIERTO |" in line:
        lines[i] = line.replace("| ABIERTO | — |", f"| RESUELTO | {nota} |")
        break
open(path, "w").write("\n".join(lines))
PYEOF
            echo "Pendiente resuelto: $3 — $4"
        else
            echo "ERROR: no hay pendiente ABIERTO de $3 en la cola" >&2
            exit 1
        fi
        ;;
      check)
        [ -f "$PENDIENTES_FILE" ] || { echo "OK — cola vacía, la fase puede cerrarse."; exit 0; }
        abiertos=$(grep -c "| ABIERTO |" "$PENDIENTES_FILE" || true)
        if [ "${abiertos:-0}" -gt 0 ]; then
            echo "BLOQUEADO: hay ${abiertos} pendiente(s) ABIERTO(s) en la cola de fase."
            echo "Resolver con: ura-udo pendientes resolver TASK-ID \"nota\""
            echo "O justificar por Ramón (aprobación expresa) antes de cerrar la fase."
            exit 1
        else
            echo "OK — cola de pendientes resuelta, la fase puede cerrarse."
        fi
        ;;
      *)
        echo "Uso: ura-udo pendientes {add TASK \"texto\" | list | resolver TASK \"nota\" | check}" >&2
        exit 1
        ;;
    esac
    ;;

  diff)
    # Resumen de cambios por tarea (auditoría): qué archivos tocó la TASK
    # entre commit_base y HEAD, con estadísticas. Sin git show completo.
    [ -n "${2:-}" ] || { echo "Uso: ura-udo diff TASK-ID" >&2; exit 1; }
    _ver_tarea "$2"
    id="$2"
    file="$TASKS_DIR/$id.md"
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    [ -n "$base" ] && [ "$base" != "unknown" ] || { echo "ERROR: sin commit_base (¿tarea nunca fue IN_PROGRESS?)" >&2; exit 1; }
    echo "TASK: $id"
    echo "RANGO: $base..HEAD"
    echo ""
    # Resumen por archivo (--stat) + nombres, sin el contenido completo
    git -C "$REPO" diff --stat "$base..HEAD" 2>/dev/null || { echo "ERROR: no se pudo calcular el diff" >&2; exit 1; }
    echo ""
    echo "--- Archivos tocados ---"
    git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null | sed 's/^/  /'
    ;;

  verify)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    id="$2"
    _ver_tarea "$id"
    file="$TASKS_DIR/$id.md"
    echo "TASK: $id"
    echo "STATUS: $(grep '^estado:' "$file" | cut -d' ' -f2- || echo '—')"
    echo "RESERVA: [$(grep '^reserva:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)]"
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    echo "COMMIT_BASE: ${base:-—}"
    # Análisis/validación (PLAN 1 A1/A2): WARNING informativo si el expediente
    # no los tiene (tareas pre-parche) — no bloquea, no es retroactivo (X2).
    if grep -q '^analisis:' "$file"; then
        an=$(grep '^analisis:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
        [ -n "$an" ] && [ "$an" != "—" ] && echo "ANALISIS: OK" || echo "ANALISIS: WARNING — vacío (tarea pre-parche o sin análisis)"
    else
        echo "ANALISIS: INFO — campo ausente (tarea pre-parche, PLAN 1 A1 no retroactivo)"
    fi
    echo ""

    echo "REQUEST: OK"

    commit=$(git -C "$REPO" log --oneline --grep="$id" -1 2>/dev/null || true)
    if [ -n "$commit" ]; then
        echo "COMMIT: OK — $commit"
        _lock
        actual_commits=$(grep '^commits:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
        if ! grep -qF "$commit" <<< "$actual_commits"; then
            if [ -n "$actual_commits" ]; then
                _set_campo "$id" "commits" "[$actual_commits, $commit]"
            else
                _set_campo "$id" "commits" "[$commit]"
            fi
        fi
    else
        echo "COMMIT: WARNING — sin commit con [$id]"
    fi

    # --- Discrepancias reserva vs modificado (F2) ---
    # Match por cobertura (exacto o prefijo dir/) — misma lógica que el
    # enforcement de _conflicto_reserva. docs/udo/tasks|.seq se ignoran
    # (bookkeeping del expediente).
    reserva=$(_reserva "$id")
    tocados=""
    if [ -n "$base" ] && [ "$base" != "unknown" ]; then
        tocados=$(git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null || true)
        tocados=$( { echo "$tocados"; git -C "$REPO" status --porcelain | sed 's/^...//'; } | sed 's/^ *//' | grep -v '^$' | sort -u || true )
    else
        tocados=$(git -C "$REPO" status --porcelain | sed 's/^...//' | sed 's/^ *//' | grep -v '^$' | sort -u || true)
    fi
    echo ""
    echo "--- Discrepancias (reserva vs git) ---"
    if [ -z "$tocados" ]; then
        echo "  INFO: sin archivos modificados en rango/working tree (¿commit pendiente?)"
    else
        hay_no_declarados=""
        for t in $tocados; do
            case "$t" in
                docs/udo/tasks/*|docs/udo/.seq) continue ;;
            esac
            cubierto=0
            for r in $(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | grep -v '^$'); do
                r="${r%/}"
                if [[ "$t" == "$r" || "$t" == "$r/"* ]]; then cubierto=1; break; fi
            done
            if [ "$cubierto" = 0 ]; then
                hay_no_declarados=1
                echo "  MODIFICADOS SIN DECLARAR:"
                echo "    $t"
            fi
        done
        [ -z "$hay_no_declarados" ] && echo "  OK: todos los archivos modificados están declarados en reserva"
        if [ -n "$reserva" ]; then
            no_tocados=""
            for r in $(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | grep -v '^$'); do
                r="${r%/}"
                cubierto=0
                for t in $tocados; do
                    if [[ "$t" == "$r" || "$t" == "$r/"* ]]; then cubierto=1; break; fi
                done
                [ "$cubierto" = 0 ] && no_tocados="$no_tocados $r"
            done
            if [ -n "$no_tocados" ]; then
                echo "  RESERVADOS NO MODIFICADOS (liberación sugerida):"
                echo "$no_tocados" | sed 's/^ /    /'
            fi
        fi
    fi
    dirty=$(git -C "$REPO" status --porcelain | head -3 || true)
    echo ""
    if [ -n "$dirty" ]; then
        echo "GIT: WARNING — hay cambios sin commit"
        echo "$dirty" | sed 's/^/  /'
    else
        echo "GIT: OK"
    fi

    # --- F4 (N5): cruce cambios declarados vs archivos reales modificados ---
    # El campo cambios: del expediente debe coincidir con lo que git muestra.
    # WARNING si hay archivos modificados fuera de lo declarado, o si se
    # declararon cambios que git no refleja.
    echo ""
    echo "--- Coherencia cambios declarados vs git (F4) ---"
    decl=$(grep '^cambios:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
    if [ -n "$decl" ]; then
        fuera=""
        for t in $tocados; do
            case "$t" in
                docs/udo/tasks/*|docs/udo/.seq) continue ;;
            esac
            cubierto=0
            for d in $(echo "$decl" | tr ',' '\n' | sed 's/^ *//' | grep -v '^$'); do
                d="${d%/}"
                if [[ "$t" == "$d" || "$t" == "$d/"* ]]; then cubierto=1; break; fi
            done
            [ "$cubierto" = 0 ] && fuera="$fuera $t"
        done
        if [ -n "$fuera" ]; then
            echo "  WARNING: archivos modificados NO declarados en cambios:"
            echo "$fuera" | sed 's/^/    /'
        else
            echo "  OK: cambios declarados cubren los archivos modificados"
        fi
    else
        echo "  INFO: sin campo cambios: declarado (tarea pre-F4 o sin declaración)"
    fi

    # --- F4 (N4): validación declarada vs evidencia (heurístico, no ejecuta) ---
    va2=$(grep '^validacion:' "$file" | cut -d' ' -f2- | sed 's/^ //' || true)
    if [ -n "$va2" ] && [ "$va2" != "—" ]; then
        case "$va2" in
            *test*|*suite*|*pytest*|*OK*|*PASS*)
                echo "  NOTA: validacion declarada: \"$va2\" — verificar manualmente ejecutando las pruebas citadas (§5.8-B)"
                ;;
        esac
    else
        echo "  INFO: sin validacion declarada (tarea pre-F4)"
    fi
    ;;

  *)
    _uso
    ;;
esac
