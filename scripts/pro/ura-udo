#!/bin/bash
# ura-udo — Capa mínima de coordinación UDO (F1 + F2)
# Uso: ura-udo create "desc" | show TASK-ID | update TASK-ID [--estado X] [--nota "…"] [--reserva "r1,r2"]
#      | reserve TASK-ID [--add "r1,r2"] [--clear] | check [ruta...]
#      | list [--estado] | status | verify TASK-ID
# Fuente de verdad: Git (código) + docs/udo/ (proceso). Sin BD, sin panel.

set -euo pipefail

UDO_ROOT="${UDO_ROOT:-$HOME/URA/ura_ia_1972/docs/udo}"
TASKS_DIR="$UDO_ROOT/tasks"
SEQ_FILE="$UDO_ROOT/.seq"
LOCK_FILE="$UDO_ROOT/.lock"
REPO="${UDO_REPO:-$HOME/URA/ura_ia_1972}"

declare -A ESTADOS_VALIDOS=( [PLANNED]=1 [IN_PROGRESS]=1 [REVIEW]=1 [DONE]=1 [BLOCKED]=1 [CONFLICT]=1 [CANCELLED]=1 )
# Estados "activos": su reserva protege archivos frente a otras tareas
ESTADOS_ACTIVOS="IN_PROGRESS|REVIEW"

_fecha()      { date +%Y-%m-%d; }
_fecha_hora() { date +%Y-%m-%dT%H:%M; }
_num()        { printf '%03d' "$1"; }

# --- ID único sin colisiones: contador global monotónico por fecha
_id_nuevo() {
    local hoy seq
    hoy="$(_fecha | tr -d '-')"
    seq=1
    if [ -f "$SEQ_FILE" ]; then
        seq=$(grep "^$hoy:" "$SEQ_FILE" 2>/dev/null | cut -d: -f2 || echo 0)
        seq=$((seq + 1))
    fi
    local tmp="${SEQ_FILE}.tmp.$$"
    (grep -v "^$hoy:" "$SEQ_FILE" 2>/dev/null || true; echo "$hoy:$seq") > "$tmp"
    mv "$tmp" "$SEQ_FILE"
    echo "TASK-$hoy-$(_num "$seq")"
}

_uso() {
    echo "Uso: ura-udo create \"desc\" | show TASK-ID | update TASK-ID [--estado X] [--nota \"…\"] [--reserva \"r1,r2\"]"
    echo "     | reserve TASK-ID [--add \"r1,r2\"] [--clear] | check [ruta...]"
    echo "     | list [--estado] | status | verify TASK-ID"
}

# --- Escritura con flock (ADR-002) para concurrencia segura
_lock() {
    exec 9>"$LOCK_FILE"
    flock -n 9 || { echo "ERROR: lock en uso (otro proceso ura-udo activo)" >&2; exit 1; }
}

_ver_tarea() {
    local id="$1"
    [ -f "$TASKS_DIR/$id.md" ] || { echo "ERROR: tarea no encontrada: $id" >&2; exit 1; }
}

_estado() {
    grep '^estado:' "$TASKS_DIR/$1.md" | cut -d' ' -f2-
}

_set_campo() {
    local id="$1" clave="$2" valor="$3" archivo="$TASKS_DIR/$id.md"
    if grep -q "^$clave:" "$archivo"; then
        sed -i "s|^$clave: .*|$clave: $valor|" "$archivo"
    else
        echo "$clave: $valor" >> "$archivo"
    fi
}

# --- Reserva de una tarea como lista JSON-like: [ruta1, ruta2]
_reserva() {
    grep '^reserva:' "$TASKS_DIR/$1.md" 2>/dev/null | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true
}

_apuntar() {
    local id="$1" nota="$2" est="$3"
    echo "  - \"$(_fecha_hora) | ${est:-?} | $nota\"" >> "$TASKS_DIR/$id.md"
}

# --- Expande una lista CSV a tuplas "ruta" (línea por línea)
_csv_a_lineas() {
    echo "$1" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true
}

case "${1:-}" in

  create)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _lock
    id="$(_id_nuevo)"
    file="$TASKS_DIR/$id.md"
    {
        echo "---"
        echo "id: $id"
        echo "fecha: $(_fecha)"
        echo "solicitante: ${URA_SOLICITANTE:-RAMON}"
        echo "descripcion: $2"
        echo "objetivo: "
        echo "estado: PLANNED"
        echo "canal: ${URA_SOLICITANTE:-RAMON}"
        echo "agente_web: "
        echo "agente_terminal: "
        echo "reserva: []"
        echo "commit_base: "
        echo "contexto: "
        echo "cambios: []"
        echo "commits: []"
        echo "revision: "
        echo "pendientes: []"
        echo "resultado: "
        echo "historial:"
        echo "  - \"$(_fecha_hora) | PLANNED | creada\""
        echo "---"
    } > "$file"
    echo "Creada: $id -> $file"
    ;;

  show)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    cat "$TASKS_DIR/$2.md"
    ;;

  update)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; estado="" nota="" reserva="" reserva_flag="" agente_web_val="" agente_terminal_val=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --estado)  estado="${2:-}"; shift 2 ;;
            --nota)    nota="${2:-}"; shift 2 ;;
            --reserva) reserva_flag=1; reserva="${2:-}"; shift 2 ;;
            --agente_web)      agente_web_val="${2:-}"; shift 2 ;;
            --agente_terminal) agente_terminal_val="${2:-}"; shift 2 ;;
            *) echo "ERROR: argumento desconocido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    file="$TASKS_DIR/$id.md"
    est_actual=$(_estado "$id")
    if [ -n "$estado" ]; then
        if [ -z "${ESTADOS_VALIDOS[$estado]:-}" ]; then
            echo "ERROR: estado inválido '$estado' (válidos: ${!ESTADOS_VALIDOS[*]})" >&2
            exit 1
        fi
        _set_campo "$id" "estado" "$estado"
        hist="$est_actual -> $estado${nota:+ — $nota}"
    else
        hist="$nota"
    fi
    # Auto-registro del commit base: al comenzar IN_PROGRESS, o si falta en
    # una tarea ya en IN_PROGRESS (compatibilidad con tareas pre-F2)
    if [ "$est_actual" = "IN_PROGRESS" ] || [ "$estado" = "IN_PROGRESS" ]; then
        if [ -z "$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)" ]; then
            base=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            _set_campo "$id" "commit_base" "$base"
        fi
    fi
    if [ -n "$reserva" ]; then
        _set_campo "$id" "reserva" "[$reserva]"
        hist="${hist:+$hist — }reserva: [$reserva]"
    elif [ -n "${reserva_flag:-}" ]; then
        _set_campo "$id" "reserva" "[]"
        hist="${hist:+$hist — }reserva: []"
    fi
    if [ -n "$agente_web_val" ]; then
        _set_campo "$id" "agente_web" "$agente_web_val"
        hist="${hist:+$hist — }agente_web: $agente_web_val"
    fi
    if [ -n "$agente_terminal_val" ]; then
        _set_campo "$id" "agente_terminal" "$agente_terminal_val"
        hist="${hist:+$hist — }agente_terminal: $agente_terminal_val"
    fi
    if [ -n "$hist" ]; then
        _apuntar "$id" "$hist" "${estado:-$est_actual}"
    fi
    echo "Actualizada: $id (estado: ${estado:-$est_actual})"
    ;;

  reserve)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; accion="" ruta=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --add)   accion="add";   ruta="${2:-}"; shift 2 ;;
            --clear) accion="clear"; shift ;;
            *) echo "ERROR: argumento no válido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    actual=$(_reserva "$id")
    if [ "$accion" = "clear" ]; then
        nueva=""
    elif [ "$accion" = "add" ] && [ -n "$ruta" ]; then
        [ -n "$actual" ] && nueva="$actual, $ruta" || nueva="$ruta"
    else
        echo "Reserva actual de $id: [$actual]"
        exit 0
    fi
    _set_campo "$id" "reserva" "[$nueva]"
    _apuntar "$id" "reserva: [$nueva]" "$(_estado "$id")"
    echo "Reserva de $id: [$nueva]"
    ;;

  check)
    # check sin rutas: lista las reservas activas (IN_PROGRESS/REVIEW)
    # check con rutas: detector de conflicto frente a las reservas activas
    shift
    keys=()
    while IFS= read -r f; do
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW)
                res=$(grep '^reserva:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true)
                if [ -n "$res" ]; then
                    while IFS= read -r r; do
                        keys+=("$(basename "$f" .md)|$r")
                    done <<< "$res"
                fi
                ;;
        esac
    done < <(ls "$TASKS_DIR"/*.md 2>/dev/null || true)

    if [ $# -eq 0 ]; then
        if [ ${#keys[@]} -eq 0 ]; then
            echo "Sin reservas activas."
        else
            echo "Reservas activas:"
            printf '  %s\n' "${keys[@]}"
        fi
        exit 0
    fi
    # conflicto contra rutas dadas (args restantes tras shift)
    conflicto=0
    for ruta in "$@"; do
        for k in "${keys[@]}"; do
            id_res="${k%%|*}"; area="${k#*|}"
            if [[ "$ruta" == "$area" || "$ruta" == "$area/"* ]]; then
                echo "CONFLICTO: '$ruta' está reservada por $id_res ($area)"
                conflicto=1
            fi
        done
    done
    if [ "$conflicto" -eq 0 ]; then
        echo "OK: ninguna ruta colisiona con reservas activas. Tomando: $*"
    fi
    exit 0
    ;;

  list)
    filtro="${2:-}"
    echo "=== TAREAS ==="
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        if [ -n "$filtro" ]; then
            [ "$est" = "$filtro" ] || continue
        fi
        echo "  $(basename "$f" .md) [$est]"
    done | grep -v '^$'
    ;;

  status)
    echo "=== UDO — estado del proyecto ==="
    echo "--- En curso ---"
    "$0" list IN_PROGRESS
    echo "--- En revisión ---"
    "$0" list REVIEW
    echo "--- Bloqueadas ---"
    "$0" list BLOCKED
    echo "--- Reservas activas ---"
    "$0" check
    echo "--- Últimos commits ---"
    git -C "$REPO" log --oneline -5
    ;;

  verify)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    id="$2"
    _ver_tarea "$id"
    file="$TASKS_DIR/$id.md"
    echo "TASK: $id"
    echo "STATUS: $(grep '^estado:' "$file" | cut -d' ' -f2- || echo '—')"
    echo "RESERVA: [$(grep '^reserva:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)]"
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    echo "COMMIT_BASE: ${base:-—}"
    echo ""

    echo "REQUEST: OK"

    commit=$(git -C "$REPO" log --oneline --grep="$id" -1 2>/dev/null || true)
    if [ -n "$commit" ]; then
        echo "COMMIT: OK — $commit"
        _lock
        actual_commits=$(grep '^commits:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
        if ! grep -qF "$commit" <<< "$actual_commits"; then
            if [ -n "$actual_commits" ]; then
                _set_campo "$id" "commits" "[$actual_commits, $commit]"
            else
                _set_campo "$id" "commits" "[$commit]"
            fi
        fi
    else
        echo "COMMIT: WARNING — sin commit con [$id]"
    fi

    # --- Discrepancias reserva vs modificado (F2) ---
    reserva=$(_reserva "$id")
    tocados=""
    if [ -n "$base" ] && [ "$base" != "unknown" ]; then
        tocados=$(git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null || true)
        tocados=$( { echo "$tocados"; git -C "$REPO" status --porcelain | sed 's/^...//'; } | sed 's/^ *//' | grep -v '^$' | sort -u || true )
    else
        tocados=$(git -C "$REPO" status --porcelain | sed 's/^...//' | sed 's/^ *//' | grep -v '^$' | sort -u || true)
    fi
    echo ""
    echo "--- Discrepancias (reserva vs git) ---"
    if [ -z "$tocados" ]; then
        echo "  INFO: sin archivos modificados en rango/working tree (¿commit pendiente?)"
    else
        no_declarados=$(comm -23 <(grep -v '^docs/udo/\(tasks\|\.seq\)' <<< "$tocados" | sort -u) <(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | sort -u) 2>/dev/null || true)
        if [ -n "$no_declarados" ]; then
            echo "  MODIFICADOS SIN DECLARAR:"
            echo "$no_declarados" | sed 's/^/    /'
        else
            echo "  OK: todos los archivos modificados están declarados en reserva"
        fi
        if [ -n "$reserva" ]; then
            no_tocados=$(comm -13 <(echo "$tocados" | sort -u) <(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | sort -u) 2>/dev/null || true)
            if [ -n "$no_tocados" ]; then
                echo "  RESERVADOS NO MODIFICADOS (liberación sugerida):"
                echo "$no_tocados" | sed 's/^/    /'
            fi
        fi
    fi
    dirty=$(git -C "$REPO" status --porcelain | head -3 || true)
    echo ""
    if [ -n "$dirty" ]; then
        echo "GIT: WARNING — hay cambios sin commit"
        echo "$dirty" | sed 's/^/  /'
    else
        echo "GIT: OK"
    fi
    ;;

  *)
    _uso
    ;;
esac