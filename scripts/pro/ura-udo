#!/bin/bash
# ura-udo — Capa mínima de coordinación UDO (F1 + F2)
# Uso: ura-udo create "desc" | show TASK-ID | update TASK-ID [--estado X] [--nota "…"] [--reserva "r1,r2"] [--force]
#      | reserve TASK-ID [--add "r1,r2"] [--clear] | check [ruta...]
#      | list [--estado] | status | verify TASK-ID | context TASK-ID
# Fuente de verdad: Git (código) + docs/udo/ (proceso). Sin BD, sin panel.

set -euo pipefail

UDO_ROOT="${UDO_ROOT:-$HOME/URA/ura_ia_1972/docs/udo}"
TASKS_DIR="$UDO_ROOT/tasks"
SEQ_FILE="$UDO_ROOT/.seq"
LOCK_FILE="$UDO_ROOT/.lock"
REPO="${UDO_REPO:-$HOME/URA/ura_ia_1972}"

declare -A ESTADOS_VALIDOS=( [PLANNED]=1 [IN_PROGRESS]=1 [REVIEW]=1 [DONE]=1 [BLOCKED]=1 [CONFLICT]=1 [CANCELLED]=1 )
# Estados "activos": su reserva protege archivos frente a otras tareas
# (usado por check y por el enforcement de reservas en reserve/update)

_fecha()      { date +%Y-%m-%d; }
_fecha_hora() { date +%Y-%m-%dT%H:%M; }
_num()        { printf '%03d' "$1"; }

# --- ID único sin colisiones: contador global monotónico por fecha
_id_nuevo() {
    local hoy seq
    hoy="$(_fecha | tr -d '-')"
    seq=1
    if [ -f "$SEQ_FILE" ]; then
        seq=$(grep "^$hoy:" "$SEQ_FILE" 2>/dev/null | cut -d: -f2 || echo 0)
        seq=$((seq + 1))
    fi
    local tmp="${SEQ_FILE}.tmp.$$"
    (grep -v "^$hoy:" "$SEQ_FILE" 2>/dev/null || true; echo "$hoy:$seq") > "$tmp"
    mv "$tmp" "$SEQ_FILE"
    echo "TASK-$hoy-$(_num "$seq")"
}

_uso() {
    echo "Uso: ura-udo create \"desc\" | show TASK-ID | update TASK-ID [--estado X] [--nota \"…\"] [--reserva \"r1,r2\"] [--force] [--instrucciones …] [--restricciones …] [--revisor …]"
    echo "     | reserve TASK-ID [--add \"r1,r2\"] [--clear] | check [ruta...]"
    echo "     | list [--estado] | status | verify TASK-ID | context TASK-ID"
}

# --- Escritura con flock (ADR-002) para concurrencia segura.
# Espera hasta 30s (bloqueante) en lugar de fallar: Web y TERM compiten por
# escribir; con espera se serializan sin error espurio (carrera controlada).
_lock() {
    exec 9>"$LOCK_FILE"
    flock -w 30 9 || { echo "ERROR: lock no disponible en 30s (otro proceso ura-udo activo)" >&2; exit 1; }
}

_ver_tarea() {
    local id="$1"
    [ -f "$TASKS_DIR/$id.md" ] || { echo "ERROR: tarea no encontrada: $id" >&2; exit 1; }
}

_estado() {
    grep '^estado:' "$TASKS_DIR/$1.md" | cut -d' ' -f2-
}

# --- _set_campo: actualiza o añade un campo. Los campos nuevos se insertan
# antes de la sección `historial:` (estructura canónica estable) y se escapan
# los caracteres sensibles a sed (@, &, \). Nunca al final del expediente.
_set_campo() {
    local id="$1" clave="$2" valor="$3" archivo="$TASKS_DIR/$id.md"
    valor=$(printf '%s' "$valor" | sed 's/\\/\\\\/g; s/@/\\@/g; s/&/\\&/g')
    if grep -q "^$clave:" "$archivo"; then
        sed -i "s@^$clave: .*@$clave: $valor@" "$archivo"
    elif grep -q '^historial:' "$archivo"; then
        sed -i "s@^historial:@$clave: $valor\nhistorial:@" "$archivo"
    else
        printf '%s: %s\n' "$clave" "$valor" >> "$archivo"
    fi
}

# --- Reserva de una tarea como lista JSON-like: [ruta1, ruta2]
_reserva() {
    grep '^reserva:' "$TASKS_DIR/$1.md" 2>/dev/null | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true
}

_apuntar() {
    local id="$1" nota="$2" est="$3"
    echo "  - \"$(_fecha_hora) | ${est:-?} | $nota\"" >> "$TASKS_DIR/$id.md"
}

# --- Reservas activas (otras tareas distintas de la indicada): "TASK|ruta"
_reservas_activas_ajenas() {
    local self="$1"
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW)
                id_res=$(basename "$f" .md)
                [ "$id_res" = "$self" ] && continue
                res=$(grep '^reserva:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
                if [ -n "$res" ]; then
                    printf '%s|%s\n' "$id_res" "$res"
                fi
                ;;
        esac
    done
}

# --- Enforcement de reservas: rechaza declarar rutas reservadas por otra tarea
# activa (match exacto o prefijo dir/). Devuelve 1 si hay conflicto.
_conflicto_reserva() {
    local self="$1" rutas="$2" r area id_res
    rutas=$(printf '%s' "$rutas" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true)
    [ -n "$rutas" ] || return 0
    while IFS='|' read -r id_res area; do
        [ -n "$area" ] || continue
        area="${area%/}"
        for r in $rutas; do
            if [[ "$r" == "$area" || "$r" == "$area/"* ]]; then
                echo "ERROR: '$r' está reservada por $id_res (reserva activa). Libera con reserve $id_res --clear o usa --force para autorización expresa." >&2
                return 1
            fi
        done
    done < <(_reservas_activas_ajenas "$self")
    return 0
}

# --- Gate de integridad de revisión (F2.2, al cerrar DONE): exige que la
# revisión signifique algo. Ejecuta solo sin --force.
_gate_revision() {
    local id="$1" file="$TASKS_DIR/$1.md" base commits tocados sha r sucio
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    if [ -z "$base" ] || [ "$base" = "unknown" ]; then
        echo "ERROR: DONE requiere commit_base (¿tarea nunca fue IN_PROGRESS?)" >&2
        return 1
    fi
    commits=$(grep '^commits:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
    if [ -z "$commits" ]; then
        echo "ERROR: DONE requiere commits registrados — ejecuta 'ura-udo verify TASK' antes de cerrar" >&2
        return 1
    fi
    tocados=$(git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null || true)
    tocados=$( { echo "$tocados"; git -C "$REPO" status --porcelain | sed 's/^...//'; } | sed 's/^ *//' | grep -v '^$' | grep -v '^docs/udo/\(tasks\|\.seq\)' | sort -u || true )
    if [ -z "$tocados" ]; then
        echo "ERROR: DONE sin trabajo revisable (diff commit_base..HEAD vacío y árbol limpio)" >&2
        return 1
    fi
    local IFS=','
    for entry in $(echo "$commits"); do
        sha="${entry# }"; sha="${sha%% *}"
        if ! git -C "$REPO" merge-base --is-ancestor "$sha" HEAD 2>/dev/null; then
            echo "ERROR: DONE bloqueado — commit '$sha' no es ancestro de HEAD (historia reescrita tras verificación)" >&2
            return 1
        fi
    done
    sucio=$(git -C "$REPO" status --porcelain | grep -v '^??' | sed 's/^...//' | grep -v '^docs/udo/\(tasks\|\.seq\)' || true)
    if [ -n "$sucio" ]; then
        echo "ERROR: DONE bloqueado — cambios sin commitear fuera del expediente:" >&2
        echo "$sucio" | sed 's/^/  /' >&2
        return 1
    fi
    return 0
}

# --- Determina si el cierre es auto-revisión: revisor vacío o == ejecutor.
_es_auto_revision() {
    local id="$1" revisor="$2" ejecutor="" campo v
    if [ -z "$revisor" ]; then
        return 0
    fi
    for campo in agente_web agente_terminal; do
        v=$(grep "^$campo: " "$TASKS_DIR/$id.md" | cut -d' ' -f2- || true)
        case "$v" in
            *"(ejecutor)"*) ejecutor="${v%% (ejecutor)*}"; break ;;
        esac
    done
    [ -n "$ejecutor" ] && [ "$revisor" = "$ejecutor" ]
}

case "${1:-}" in

  create)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _lock
    id="$(_id_nuevo)"
    file="$TASKS_DIR/$id.md"
    {
        echo "---"
        echo "id: $id"
        echo "fecha: $(_fecha)"
        echo "solicitante: ${URA_SOLICITANTE:-RAMON}"
        echo "descripcion: $2"
        echo "objetivo: "
        echo "instrucciones: "
        echo "restricciones: "
        echo "estado: PLANNED"
        echo "canal: ${URA_SOLICITANTE:-RAMON}"
        echo "agente_web: "
        echo "agente_terminal: "
        echo "revisor: "
        echo "reserva: []"
        echo "commit_base: "
        echo "contexto: "
        echo "cambios: []"
        echo "commits: []"
        echo "revision: "
        echo "pendientes: []"
        echo "resultado: "
        echo "historial:"
        echo "  - \"$(_fecha_hora) | PLANNED | creada\""
        echo "---"
    } > "$file"
    echo "Creada: $id -> $file"
    ;;

  show)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    cat "$TASKS_DIR/$2.md"
    ;;

  context)
    # Contexto compartido (F2): expediente + últimos commits + reservas activas
    # que puedan afectar a la zona. Recuperable aunque el otro agente esté idle
    # (fuente de verdad: Git + expediente, no la conversación).
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"
    file="$TASKS_DIR/$id.md"
    echo "=== CONTEXTO UDO — $id ==="
    echo "ID: $id"
    echo "Estado: $(_estado "$id")"
    grep -E '^(descripcion|objetivo|instrucciones|restricciones|canal|agente_web|agente_terminal|revisor|reserva|commit_base|contexto|resultado|pendientes):' "$file" | sed 's/^/  /'
    echo "--- Últimos commits ---"
    git -C "$REPO" log --oneline --grep="$id" -5 2>/dev/null || true
    echo "--- Reservas activas que afectan ---"
    "$0" check 2>/dev/null | head -10 || true
    echo "--- Historial (últimas 5) ---"
    grep -A 5 '^historial:' "$file" | head -6 | sed 's/^/  /'
    ;;

  update)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; estado="" nota="" reserva="" reserva_flag="" agente_web_val="" agente_terminal_val="" instrucciones_val="" restricciones_val="" revisor_val="" force=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --estado)  estado="${2:-}"; shift 2 ;;
            --nota)    nota="${2:-}"; shift 2 ;;
            --reserva) reserva_flag=1; reserva="${2:-}"; shift 2 ;;
            --agente_web)      agente_web_val="${2:-}"; shift 2 ;;
            --agente_terminal) agente_terminal_val="${2:-}"; shift 2 ;;
            --instrucciones)   instrucciones_val="${2:-}"; shift 2 ;;
            --restricciones)   restricciones_val="${2:-}"; shift 2 ;;
            --revisor)         revisor_val="${2:-}"; shift 2 ;;
            --force)   force=1; shift ;;
            *) echo "ERROR: argumento desconocido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    file="$TASKS_DIR/$id.md"
    est_actual=$(_estado "$id")
    if [ -n "$estado" ]; then
        if [ -z "${ESTADOS_VALIDOS[$estado]:-}" ]; then
            echo "ERROR: estado inválido '$estado' (válidos: ${!ESTADOS_VALIDOS[*]})" >&2
            exit 1
        fi
        # Regla de integridad (F2, CASO B): DONE solo desde REVIEW — sin
        # revisión válida previa, la tarea no puede cerrarse. Excepción:
        # --force explícito con nota (autorización expresa, queda auditada).
        if [ "$estado" = "DONE" ] && [ "$est_actual" != "REVIEW" ] && [ -z "$force" ]; then
            echo "ERROR: DONE solo desde REVIEW (revisión previa requerida — CASO B). Usa --force si es una excepción explícita." >&2
            exit 1
        fi
        # Gate de integridad de revisión (F2.2): al cerrar DONE sin --force,
        # la revisión debe significar algo (commits registrados, diff no vacío,
        # SHAs ancestrales, árbol limpio fuera del expediente).
        if [ "$estado" = "DONE" ] && [ -z "$force" ]; then
            _gate_revision "$id" || exit 1
        fi
        _set_campo "$id" "estado" "$estado"
        hist="$est_actual -> $estado${nota:+ — $nota}"
        if [ "$estado" = "DONE" ] && [ "$est_actual" != "REVIEW" ] && [ -n "$force" ]; then
            hist="${hist} — AUTORIZACIÓN EXPRESA (--force)"
        fi
        # Marca honesta de auto-revisión (F2.2): la dice la herramienta, no el
        # texto libre. Revisor vacío o igual al ejecutor = AUTO-REVISIÓN.
        if [ "$estado" = "DONE" ]; then
            if _es_auto_revision "$id" "${revisor_val:-}"; then
                hist="${hist} — AUTO-REVISIÓN${revisor_val:+ (revisor=$revisor_val)}"
            elif [ -n "$revisor_val" ]; then
                _set_campo "$id" "revisor" "$revisor_val"
                hist="${hist} — revisión por $revisor_val"
            fi
        elif [ -n "$revisor_val" ]; then
            _set_campo "$id" "revisor" "$revisor_val"
        fi
    else
        hist="$nota"
    fi
    # Auto-registro del commit base: al comenzar IN_PROGRESS, o si falta en
    # una tarea ya en IN_PROGRESS (compatibilidad con tareas pre-F2)
    if [ "$est_actual" = "IN_PROGRESS" ] || [ "$estado" = "IN_PROGRESS" ]; then
        if [ -z "$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)" ]; then
            base=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo "unknown")
            _set_campo "$id" "commit_base" "$base"
        fi
    fi
    if [ -n "$reserva" ]; then
        # Enforcement (F2): no declarar rutas reservadas por otra tarea activa
        # --force = autorización expresa (queda en historial como excepción)
        if [ -z "$force" ]; then
            _conflicto_reserva "$id" "$reserva" || exit 1
        else
            hist="${hist:+$hist — }AUTORIZACIÓN EXPRESA (--force) sobre: $reserva"
        fi
        _set_campo "$id" "reserva" "[$reserva]"
        hist="${hist:+$hist — }reserva: [$reserva]"
    elif [ -n "${reserva_flag:-}" ]; then
        _set_campo "$id" "reserva" "[]"
        hist="${hist:+$hist — }reserva: []"
    fi
    if [ -n "$agente_web_val" ]; then
        _set_campo "$id" "agente_web" "$agente_web_val"
        hist="${hist:+$hist — }agente_web: $agente_web_val"
    fi
    if [ -n "$agente_terminal_val" ]; then
        _set_campo "$id" "agente_terminal" "$agente_terminal_val"
        hist="${hist:+$hist — }agente_terminal: $agente_terminal_val"
    fi
    if [ -n "$instrucciones_val" ]; then
        _set_campo "$id" "instrucciones" "$instrucciones_val"
        hist="${hist:+$hist — }instrucciones: $instrucciones_val"
    fi
    if [ -n "$restricciones_val" ]; then
        _set_campo "$id" "restricciones" "$restricciones_val"
        hist="${hist:+$hist — }restricciones: $restricciones_val"
    fi
    if [ -n "$hist" ]; then
        _apuntar "$id" "$hist" "${estado:-$est_actual}"
    fi
    echo "Actualizada: $id (estado: ${estado:-$est_actual})"
    ;;

  reserve)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    _ver_tarea "$2"
    id="$2"; accion="" ruta="" force=""
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --add)   accion="add";   ruta="${2:-}"; shift 2 ;;
            --clear) accion="clear"; shift ;;
            --force) force=1; shift ;;
            *) echo "ERROR: argumento no válido: $1" >&2; exit 1 ;;
        esac
    done
    _lock
    actual=$(_reserva "$id")
    if [ "$accion" = "clear" ]; then
        nueva=""
    elif [ "$accion" = "add" ] && [ -n "$ruta" ]; then
        # Enforcement (F2): no reservar rutas ya reservadas por otra tarea activa
        if [ -z "$force" ]; then
            _conflicto_reserva "$id" "$ruta" || exit 1
        fi
        [ -n "$actual" ] && nueva="$actual, $ruta" || nueva="$ruta"
    else
        echo "Reserva actual de $id: [$actual]"
        exit 0
    fi
    _set_campo "$id" "reserva" "[$nueva]"
    if [ -n "$force" ] && [ "$accion" = "add" ]; then
        _apuntar "$id" "reserva: [$nueva] (AUTORIZACIÓN EXPRESA --force)" "$(_estado "$id")"
    else
        _apuntar "$id" "reserva: [$nueva]" "$(_estado "$id")"
    fi
    echo "Reserva de $id: [$nueva]"
    ;;

  check)
    # check sin rutas: lista las reservas activas (IN_PROGRESS/REVIEW)
    # check con rutas: detector de conflicto frente a las reservas activas
    shift
    keys=()
    while IFS= read -r f; do
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        case "$est" in
            IN_PROGRESS|REVIEW)
                res=$(grep '^reserva:' "$f" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' || true)
                if [ -n "$res" ]; then
                    while IFS= read -r r; do
                        keys+=("$(basename "$f" .md)|$r")
                    done <<< "$res"
                fi
                ;;
        esac
    done < <(ls "$TASKS_DIR"/*.md 2>/dev/null || true)

    if [ $# -eq 0 ]; then
        if [ ${#keys[@]} -eq 0 ]; then
            echo "Sin reservas activas."
        else
            echo "Reservas activas:"
            printf '  %s\n' "${keys[@]}"
        fi
        exit 0
    fi
    # conflicto contra rutas dadas (args restantes tras shift)
    conflicto=0
    for ruta in "$@"; do
        for k in "${keys[@]}"; do
            id_res="${k%%|*}"; area="${k#*|}"
            if [[ "$ruta" == "$area" || "$ruta" == "$area/"* ]]; then
                echo "CONFLICTO: '$ruta' está reservada por $id_res ($area)"
                conflicto=1
            fi
        done
    done
    if [ "$conflicto" -eq 0 ]; then
        echo "OK: ninguna ruta colisiona con reservas activas. Tomando: $*"
    fi
    exit 0
    ;;

  list)
    filtro="${2:-}"
    echo "=== TAREAS ==="
    for f in "$TASKS_DIR"/*.md; do
        [ -f "$f" ] || continue
        est=$(grep '^estado:' "$f" | cut -d' ' -f2-)
        if [ -n "$filtro" ]; then
            [ "$est" = "$filtro" ] || continue
        fi
        echo "  $(basename "$f" .md) [$est]"
    done | grep -v '^$'
    ;;

  status)
    echo "=== UDO — estado del proyecto ==="
    echo "--- En curso ---"
    "$0" list IN_PROGRESS
    echo "--- En revisión ---"
    "$0" list REVIEW
    echo "--- Bloqueadas ---"
    "$0" list BLOCKED
    echo "--- Reservas activas ---"
    "$0" check
    echo "--- Últimos commits ---"
    git -C "$REPO" log --oneline -5
    ;;

  verify)
    [ -n "${2:-}" ] || { _uso; exit 1; }
    id="$2"
    _ver_tarea "$id"
    file="$TASKS_DIR/$id.md"
    echo "TASK: $id"
    echo "STATUS: $(grep '^estado:' "$file" | cut -d' ' -f2- || echo '—')"
    echo "RESERVA: [$(grep '^reserva:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)]"
    base=$(grep '^commit_base:' "$file" | cut -d' ' -f2- || true)
    echo "COMMIT_BASE: ${base:-—}"
    echo ""

    echo "REQUEST: OK"

    commit=$(git -C "$REPO" log --oneline --grep="$id" -1 2>/dev/null || true)
    if [ -n "$commit" ]; then
        echo "COMMIT: OK — $commit"
        _lock
        actual_commits=$(grep '^commits:' "$file" | cut -d' ' -f2- | sed 's/^\[//; s/\]$//' || true)
        if ! grep -qF "$commit" <<< "$actual_commits"; then
            if [ -n "$actual_commits" ]; then
                _set_campo "$id" "commits" "[$actual_commits, $commit]"
            else
                _set_campo "$id" "commits" "[$commit]"
            fi
        fi
    else
        echo "COMMIT: WARNING — sin commit con [$id]"
    fi

    # --- Discrepancias reserva vs modificado (F2) ---
    # Match por cobertura (exacto o prefijo dir/) — misma lógica que el
    # enforcement de _conflicto_reserva. docs/udo/tasks|.seq se ignoran
    # (bookkeeping del expediente).
    reserva=$(_reserva "$id")
    tocados=""
    if [ -n "$base" ] && [ "$base" != "unknown" ]; then
        tocados=$(git -C "$REPO" diff --name-only "$base..HEAD" 2>/dev/null || true)
        tocados=$( { echo "$tocados"; git -C "$REPO" status --porcelain | sed 's/^...//'; } | sed 's/^ *//' | grep -v '^$' | sort -u || true )
    else
        tocados=$(git -C "$REPO" status --porcelain | sed 's/^...//' | sed 's/^ *//' | grep -v '^$' | sort -u || true)
    fi
    echo ""
    echo "--- Discrepancias (reserva vs git) ---"
    if [ -z "$tocados" ]; then
        echo "  INFO: sin archivos modificados en rango/working tree (¿commit pendiente?)"
    else
        hay_no_declarados=""
        for t in $tocados; do
            case "$t" in
                docs/udo/tasks/*|docs/udo/.seq) continue ;;
            esac
            cubierto=0
            for r in $(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | grep -v '^$'); do
                r="${r%/}"
                if [[ "$t" == "$r" || "$t" == "$r/"* ]]; then cubierto=1; break; fi
            done
            if [ "$cubierto" = 0 ]; then
                hay_no_declarados=1
                echo "  MODIFICADOS SIN DECLARAR:"
                echo "    $t"
            fi
        done
        [ -z "$hay_no_declarados" ] && echo "  OK: todos los archivos modificados están declarados en reserva"
        if [ -n "$reserva" ]; then
            no_tocados=""
            for r in $(echo "$reserva" | tr ',' '\n' | sed 's/^ *//' | grep -v '^$'); do
                r="${r%/}"
                cubierto=0
                for t in $tocados; do
                    if [[ "$t" == "$r" || "$t" == "$r/"* ]]; then cubierto=1; break; fi
                done
                [ "$cubierto" = 0 ] && no_tocados="$no_tocados $r"
            done
            if [ -n "$no_tocados" ]; then
                echo "  RESERVADOS NO MODIFICADOS (liberación sugerida):"
                echo "$no_tocados" | sed 's/^ /    /'
            fi
        fi
    fi
    dirty=$(git -C "$REPO" status --porcelain | head -3 || true)
    echo ""
    if [ -n "$dirty" ]; then
        echo "GIT: WARNING — hay cambios sin commit"
        echo "$dirty" | sed 's/^/  /'
    else
        echo "GIT: OK"
    fi
    ;;

  *)
    _uso
    ;;
esac
