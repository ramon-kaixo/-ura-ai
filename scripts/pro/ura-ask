#!/bin/bash
# ura-ask — Consultor de contexto compartido (UDO F2)
# Acceso al contexto de tareas UDO (expediente + estado + commits + reservas),
# recuperable aunque el otro agente esté idle. Fuente: Git + expedientes.
# Uso: ura-ask TASK-ID | ura-ask "estado" | ura-ask (resumen)
# (El chat LLM quedó en ura-chat — esto NO es un LLM, es contexto UDO)

set -euo pipefail

UDO="$HOME/URA/ura_ia_1972/scripts/pro/ura-udo"

# Propagar raíces de prueba si están definidas (tests aislados)
export UDO_ROOT="${UDO_ROOT:-}"
export UDO_REPO="${UDO_REPO:-}"

case "${1:-}" in
    ""|status|resumen|que-hacemos)
        "$UDO" status
        ;;
    TASK-*)
        "$UDO" context "$1"
        ;;
    --help|-h)
        echo "Uso: ura-ask TASK-ID | ura-ask \"estado\" | ura-ask"
        ;;
    *)
        echo "ERROR: usa ura-ask TASK-ID (contexto de tarea) o ura-ask status (resumen)." >&2
        exit 1
        ;;
esac
