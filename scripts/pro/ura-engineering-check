#!/bin/bash
# ura-engineering-check — Comprobación de instalación de la Metodología Universal (Plan 0, §40)
# Uso: ura-engineering-check [--verbose] [--install] [--fix]
#      --install : copia deploy/engineering/AGENTS.md.global a ~/.config/opencode/AGENTS.md
#      --fix     : reinstala la copia global si está desincronizada
# Fuente de verdad: repo git (docs/engineering/). Sin BD, sin dependencias.

set -euo pipefail

REPO="${UDO_REPO:-$HOME/URA/ura_ia_1972}"
DOCS="$REPO/docs/engineering"
GLOBAL_SRC="$REPO/deploy/engineering/AGENTS.md.global"
GLOBAL_DST="${OPENCODE_GLOBAL_AGENTS:-$HOME/.config/opencode/AGENTS.md}"
CHECK_SCRIPT="$REPO/scripts/pro/ura-engineering-check"

STATUS=0

_fecha() { date +%Y-%m-%d; }

_versiones() {
    # Versión de la fuente (cabecera del ENGINEERING_PROCESS) y de la copia instalada
    local src dst
    src=$(grep -m1 -oE 'Engineering Process v[0-9]+\.[0-9]+' "$DOCS/ENGINEERING_PROCESS.md" 2>/dev/null | head -1 || echo "sin-version")
    if [ -f "$GLOBAL_DST" ]; then
        dst=$(grep -m1 -oE 'Engineering Process v[0-9]+\.[0-9]+' "$GLOBAL_DST" 2>/dev/null | head -1 || echo "sin-version")
    else
        dst="NO INSTALADA"
    fi
    printf '%s|%s' "$src" "$dst"
}

_checksum() {
    # checksum canónico: sha256sum de la fuente global vs copia instalada
    if [ -f "$GLOBAL_SRC" ] && [ -f "$GLOBAL_DST" ]; then
        a=$(sha256sum "$GLOBAL_SRC" | cut -d' ' -f1)
        b=$(sha256sum "$GLOBAL_DST" | cut -d' ' -f1)
        [ "$a" = "$b" ] && echo "OK" || echo "DESINCRONIZADO"
    else
        echo "FALTAN_ARCHIVOS"
    fi
}

_instalar() {
    mkdir -p "$(dirname "$GLOBAL_DST")"
    cp "$GLOBAL_SRC" "$GLOBAL_DST"
    echo "Instalada: $GLOBAL_DST"
}

report() {
    echo "=== ura-engineering-check ==="
    echo "Fecha:        $(_fecha)"
    echo "Repo:         $REPO"
    echo ""
    echo "--- Documentación universal (docs/engineering/) ---"
    for f in README.md ENGINEERING_PROCESS.md PLAN_TEMPLATE.md PLAN_REVIEW_TEMPLATE.md; do
        if [ -f "$DOCS/$f" ]; then
            echo "  OK   $f"
        else
            echo "  FALTA $f"
            STATUS=1
        fi
    done

    local ver_src ver_dst
    ver_src=$( _versiones | cut -d'|' -f1 )
    ver_dst=$( _versiones | cut -d'|' -f2 )
    echo ""
    echo "--- Versiones ---"
    echo "  Fuente (ENGINEERING_PROCESS): $ver_src"
    echo "  Instalada (AGENTS.md global): $ver_dst"

    echo ""
    echo "--- Copia global ($GLOBAL_DST) ---"
    if [ -f "$GLOBAL_DST" ]; then
        echo "  Presencia: OK"
        echo "  Sincronización: $(_checksum)"
        [ "$(_checksum)" != "OK" ] && STATUS=1
    else
        echo "  Presencia: FALTA (instalar con --install)"
        STATUS=1
    fi

    echo ""
    echo "--- AGENTS.md del proyecto (puntero) ---"
    if grep -q "Metodología Universal de Ingeniería" "$REPO/AGENTS.md" 2>/dev/null; then
        echo "  OK   puntero presente"
    else
        echo "  FALTA puntero a la metodología en AGENTS.md"
        STATUS=1
    fi

    echo ""
    echo "--- Verificación propia ---"
    if [ -x "$CHECK_SCRIPT" ]; then
        echo "  OK   script ejecutable"
    else
        echo "  FALTA script no ejecutable (chmod +x)"
        STATUS=1
    fi

    echo ""
    if [ "$STATUS" = "0" ]; then
        echo "RESULTADO: OK — reglas instaladas y sincronizadas"
    else
        echo "RESULTADO: INCOMPLETO — usar --install / --fix / corregir hallazgos"
    fi
    exit "$STATUS"
}

# --- Env check (PLAN 1 A3): entorno de trabajo antes de empezar ---
# Comprueba: rootfs rw/ro, servicios críticos, secretos, disco, git.
# Sin BD, sin deps: findmnt, systemctl, df, git. Salida OK/WARN/FAIL.
env_check() {
    local STATUS=0 WARN=0
    echo "=== ura-engineering-check --env ==="
    echo "Fecha:        $(_fecha)"

    echo ""
    echo "--- Rootfs (/ writable?) ---"
    local ropts
    ropts=$(findmnt -T / -o OPTIONS -n 2>/dev/null || echo "?")
    if echo "$ropts" | grep -q "ro," || [ "$ropts" = "ro" ]; then
        echo "  WARN rootfs RO ($ropts) — escrituras fuera del repo fallarán (F14-F01)"
        WARN=1
    else
        echo "  OK   rootfs rw ($ropts)"
    fi

    echo ""
    echo "--- Servicios críticos ---"
    local svc
    for svc in opencode model-router ollama ura-api; do
        local st
        st=$(systemctl is-active "$svc" 2>/dev/null || echo "unknown")
        case "$st" in
            active)   echo "  OK   $svc ($st)" ;;
            inactive|failed|unknown)
                echo "  FAIL $svc ($st)"
                STATUS=1
                ;;
            *)
                echo "  WARN $svc ($st)"
                WARN=1
                ;;
        esac
    done

    echo ""
    echo "--- Secretos ---"
    if [ -r /etc/ura/secrets.env ] && grep -q '^OPENCODE_WEB_PASS=' /etc/ura/secrets.env; then
        echo "  OK   secrets.env legible + OPENCODE_WEB_PASS"
    else
        echo "  WARN secrets.env no legible o sin OPENCODE_WEB_PASS"
        WARN=1
    fi

    echo ""
    echo "--- Disco (rootfs) ---"
    local uso
    uso=$(df / | awk 'NR==2 {gsub("%","",$5); print $5}')
    if [ -n "$uso" ] && [ "$uso" -ge 90 ]; then
        echo "  FAIL uso $uso% (>= 90)"
        STATUS=1
    elif [ -n "$uso" ]; then
        echo "  OK   uso $uso%"
    else
        echo "  WARN no se pudo leer el uso de disco"
        WARN=1
    fi

    echo ""
    echo "--- Git (repo) ---"
    if [ -d "$REPO/.git" ]; then
        if git -C "$REPO" status --porcelain 2>/dev/null | grep -qv '^??'; then
            echo "  WARN árbol sucio (cambios sin commitear)"
            WARN=1
        else
            echo "  OK   árbol limpio"
        fi
    else
        echo "  FAIL repo sin .git"
        STATUS=1
    fi

    echo ""
    if [ "$STATUS" -gt 0 ]; then
        echo "RESULTADO: FAIL — entorno degradado (revisar arriba)"
    elif [ "$WARN" -gt 0 ]; then
        echo "RESULTADO: OK CON WARNINGS — operable, atender avisos"
    else
        echo "RESULTADO: OK — entorno listo"
    fi
    exit "$STATUS"
}

# --- CLI ---
MODE=""
for arg in "$@"; do
    case "$arg" in
        --verbose|--install|--fix|--env) MODE="$arg" ;;
        *) echo "Uso: ura-engineering-check [--verbose|--install|--fix|--env]" >&2; exit 2 ;;
    esac
done

case "$MODE" in
    --install)
        _instalar
        ;;
    --fix)
        if [ "$(_checksum)" != "OK" ]; then
            _instalar
        else
            echo "Ya sincronizada: $GLOBAL_DST"
        fi
        ;;
    --env)
        env_check
        ;;
    *)
        ;;
esac

report
