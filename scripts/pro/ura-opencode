#!/bin/bash
# ura-opencode — Enviar instrucciones a OpenCode desde terminal (UDO F1)
# Uso: ura-opencode "tu mensaje aquí"
# Credenciales: OPENCODE_WEB_PASS desde entorno o /etc/ura/secrets.env (nunca en el repo)

set -euo pipefail

URL="http://10.164.1.99:8081"
USER="ramon"
MODEL="ollama/qwen2.5-coder:32b"

if [ $# -eq 0 ]; then
    echo "Uso: ura-opencode \"tu mensaje aquí\""
    exit 1
fi

# --- Secretos: env > /etc/ura/secrets.env (si legible) > fallback con aviso
if [ -z "${OPENCODE_WEB_PASS:-}" ] && [ -r /etc/ura/secrets.env ]; then
    # shellcheck disable=SC1091
    set +e
    # shellcheck source=/dev/null
    . /etc/ura/secrets.env
    set -e
fi
if [ -z "${OPENCODE_WEB_PASS:-}" ]; then
    echo "AVISO: OPENCODE_WEB_PASS no definido (env o /etc/ura/secrets.env) — usando password por defecto (inservible)" >&2
    export OPENCODE_WEB_PASS="cambiar-me"
fi

export URA_SOLICITANTE=TERM
TASK_ID=$($HOME/URA/ura_ia_1972/scripts/pro/ura-udo create "$*" | grep -o -m1 'TASK-[0-9-]*' | head -1)
[ -n "$TASK_ID" ] || { echo "ERROR: no se pudo crear la tarea UDO" >&2; exit 1; }
$HOME/URA/ura_ia_1972/scripts/pro/ura-udo update "$TASK_ID" --estado IN_PROGRESS --agente_web "WEB (ejecutor)" --agente_terminal "TERM (revisor)" --nota "enviado por ura-opencode (TERM)" >/dev/null

# Contexto compartido (F2): inyectar expediente + estado al prompt del Web.
# Fuente de verdad: Git + expediente (no la conversación). El Web arranca con
# el contexto completo aunque TERM esté idle tras el envío.
CONTEXTO=$($HOME/URA/ura_ia_1972/scripts/pro/ura-udo context "$TASK_ID" 2>/dev/null || true)
MENSAJE="$*"
if [ -n "$CONTEXTO" ]; then
    MENSAJE="$MENSAJE

===== CONTEXTO UDO (tarea $TASK_ID) — léelo antes de trabajar =====
$CONTEXTO"
fi

/home/ramon/.opencode/bin/opencode run \
    --attach "$URL" \
    --username "$USER" \
    --password "$OPENCODE_WEB_PASS" \
    -m "$MODEL" \
    "$MENSAJE" 2>&1

if [ -n "${TASK_ID:-}" ]; then
    $HOME/URA/ura_ia_1972/scripts/pro/ura-udo update "$TASK_ID" --estado REVIEW --nota "instrucción enviada a OpenCode" >/dev/null
fi
echo ""
echo "TAREA UDO: $TASK_ID ($HOME/URA/ura_ia_1972/docs/udo/tasks/$TASK_ID.md)"
