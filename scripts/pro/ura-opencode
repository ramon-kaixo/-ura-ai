#!/bin/bash
# ura-opencode — Enviar instrucciones a OpenCode desde terminal
# Uso: ura-opencode "tu mensaje aquí"

URL="http://10.164.1.99:8081"
USER="ramon"
PASS="321000"
MODEL="ollama/qwen2.5-coder:32b"

if [ $# -eq 0 ]; then
    echo "Uso: ura-opencode \"tu mensaje aquí\""
    exit 1
fi

export URA_SOLICITANTE=TERM
$HOME/URA/ura_ia_1972/scripts/pro/ura-task create "$*" >/dev/null

/home/ramon/.opencode/bin/opencode run \
    --attach "$URL" \
    --username "$USER" \
    --password "$PASS" \
    -m "$MODEL" \
    "$*" 2>&1
