      "description": "Architecture docs"
    },
    "udo": {
      "path": "docs/udo",
      "description": "UDO task system docs"
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
