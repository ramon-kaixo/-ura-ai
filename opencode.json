{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": true,
  "share": "disabled",
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "formatter": true,
  "lsp": true,
  "references": {
    "docs": {
      "path": "docs",
      "description": "URA project documentation"
    },
    "arch": {
