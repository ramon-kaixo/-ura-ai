    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow"
  },
  "experimental": {
    "openTelemetry": true,
    "batch_tool": true
  },
  "provider": {
