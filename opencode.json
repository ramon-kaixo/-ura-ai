  "customTools": {
    "memory:read": {
      "description": "Leer el contenido completo del archivo de memoria del proyecto",
      "command": "cat .opencode/memory.md"
    },
    "memory:write": {
      "description": "Sobrescribe el archivo de memoria con el contenido proporcionado",
      "command": "cat > .opencode/memory.md"
    },
    "memory:append": {
      "description": "Añade contenido al final del archivo de memoria",
      "command": "cat >> .opencode/memory.md"
    },
    "memory:search": {
      "description": "Buscar término en el archivo de memoria",
      "command": "grep -i",
      "args": [
        "$1",
        ".opencode/memory.md"
      ]
    },
    "memory:compact": {
      "description": "Fuerza compactación manual de la sesión actual",
      "command": "opencode run -- /compact"
    },
    "memory:export": {
      "description": "Exporta la sesión actual a JSON para backup",
      "command": "opencode export"
    },
    "memory:import": {
      "description": "Importa sesión desde archivo JSON",
      "command": "opencode import"
    },
    "memory:stats": {
      "description": "Muestra estadísticas de uso de tokens últimos 7 días",
      "command": "opencode stats --days 7"
    },
    "memory:list": {
      "description": "Lista todas las sesiones con sus tamaños",
      "command": "opencode session list"
    },
    "memory:cleanup": {
      "description": "Eliminar sesiones antiguas para liberar espacio",
      "command": "opencode session delete"
    }
  }
