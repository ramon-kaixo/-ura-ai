{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "gold1": "#FFD700",
    "gold2": "#DAA520",
    "gold3": "#B8860B",
    "cream": "#FFF8DC",
    "amber": "#FFBF00",
    "deep": "#2B2008",
    "soft": "#4A3B10"
  },
  "theme": {
    "primary": { "dark": "gold1", "light": "gold2" },
    "secondary": { "dark": "gold2", "light": "gold3" },
    "accent": { "dark": "amber", "light": "gold1" },
    "error": { "dark": "#FF6B6B", "light": "#CC3333" },
    "warning": { "dark": "gold1", "light": "gold3" },
    "success": { "dark": "#7CC47C", "light": "#2E7D32" },
    "info": { "dark": "gold2", "light": "gold3" },
    "text": { "dark": "cream", "light": "deep" },
    "textMuted": { "dark": "#D4C68A", "light": "soft" },
    "background": { "dark": "deep", "light": "cream" },
    "backgroundPanel": { "dark": "soft", "light": "#FFF3C4" },
    "backgroundElement": { "dark": "#3A2E0E", "light": "#FFEDB3" },
    "border": { "dark": "gold3", "light": "gold3" },
    "borderActive": { "dark": "gold1", "light": "gold2" },
    "borderSubtle": { "dark": "#5A4A14", "light": "#E8D48A" },
    "diffAdded": { "dark": "#7CC47C", "light": "#2E7D32" },
    "diffRemoved": { "dark": "#FF6B6B", "light": "#CC3333" },
    "diffContext": { "dark": "cream", "light": "deep" },
    "diffHunkHeader": { "dark": "gold2", "light": "gold3" },
    "diffHighlightAdded": { "dark": "#7CC47C", "light": "#2E7D32" },
    "diffHighlightRemoved": { "dark": "#FF6B6B", "light": "#CC3333" },
    "diffAddedBg": { "dark": "#2E3B1A", "light": "#E8F5E0" },
    "diffRemovedBg": { "dark": "#3B1A1A", "light": "#F5E0E0" },
    "diffContextBg": { "dark": "#2B2008", "light": "#FFF8DC" },
    "diffLineNumber": { "dark": "#8A7A3A", "light": "#B8A050" },
    "markdownText": { "dark": "cream", "light": "deep" },
    "markdownHeading": { "dark": "gold1", "light": "gold3" },
    "markdownLink": { "dark": "gold2", "light": "gold3" },
    "markdownLinkText": { "dark": "gold1", "light": "gold3" },
    "markdownCode": { "dark": "gold1", "light": "gold3" },
    "markdownBlockQuote": { "dark": "#D4C68A", "light": "soft" },
    "markdownEmph": { "dark": "gold2", "light": "gold3" },
    "markdownStrong": { "dark": "gold1", "light": "gold2" },
    "markdownHorizontalRule": { "dark": "gold3", "light": "gold3" },
    "markdownListItem": { "dark": "gold2", "light": "gold3" },
    "markdownCodeBlock": { "dark": "cream", "light": "deep" },
    "syntaxComment": { "dark": "#8A7A3A", "light": "#9A8A4A" },
    "syntaxKeyword": { "dark": "gold1", "light": "gold3" },
    "syntaxFunction": { "dark": "amber", "light": "gold3" },
    "syntaxVariable": { "dark": "cream", "light": "deep" },
    "syntaxString": { "dark": "#A8D8A8", "light": "#2E7D32" },
    "syntaxNumber": { "dark": "gold2", "light": "gold3" },
    "syntaxType": { "dark": "gold1", "light": "gold3" },
    "syntaxOperator": { "dark": "gold2", "light": "gold3" },
    "syntaxPunctuation": { "dark": "cream", "light": "deep" }
  }
}
