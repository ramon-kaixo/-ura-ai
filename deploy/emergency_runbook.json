{
    "version": "2.0",
    "updated_at": "2026-08-04",
    "commands": [
        "ke doctor",
        "ke init --force",
        "ke compile --force",
        "systemctl restart qdrant",
        "curl -f http://localhost:6333/health",
        "python3 -m knowledge.engine.qdrant_sync --retry",
        "df -h",
        "du -sh /tmp/* /var/log/*",
        "find /tmp -type f -atime +7 -delete"
    ],
    "scenarios": {
        "compile_fail": {
            "description": "El compile del Knowledge Engine falla repetidamente",
            "commands": [
                "ke doctor",
                "ke init --force",
                "ke compile --force",
                "ke verify"
            ],
            "escalation": "Si ke doctor reporta errores de integridad, ejecutar restore desde el ultimo archive"
        },
        "qdrant_down": {
            "description": "Qdrant no responde o coleccion corrupta",
            "commands": [
                "systemctl restart qdrant",
                "sleep 5",
                "curl -f http://localhost:6333/health",
                "python3 -m knowledge.engine.qdrant_sync --retry"
            ],
            "escalation": "Si Qdrant no recupera, restaurar desde archive de vectores (ke archive restore)"
        },
        "disk_full": {
            "description": "Disco lleno",
            "commands": [
                "df -h",
                "du -sh /tmp/* /var/log/*",
                "find /tmp -type f -atime +7 -delete",
                "systemctl restart ura-cleanup"
            ],
            "escalation": "Si no se libera espacio, expandir volumen o mover datos"
        }
    }
}