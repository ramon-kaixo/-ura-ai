[Unit]
Description=OpenCode Web Server
After=network.target

[Service]
Type=simple
User=ramon
WorkingDirectory=/home/ramon/URA/ura_ia_1972
# Secretos NO hardcoded (ver docs/architecture/SECRETS.md). Variables requeridas en /etc/ura/secrets.env:
#   OPENCODE_SERVER_USERNAME
#   OPENCODE_SERVER_PASSWORD
# La rotación de token/password es decisión y tarea de Ramón (hardening E.º sistema).
EnvironmentFile=/etc/ura/secrets.env
ExecStart=/home/ramon/.opencode/bin/opencode web --port 8081 --hostname 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target