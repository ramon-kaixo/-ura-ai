[Unit]
Description=URA Watcher — Indexación sectorizada en tiempo real
After=network-online.target ollama.service qdrant.service

[Service]
ExecStart=/usr/bin/python3 /home/ramon/URA/scripts/pro/ura_watcher.py
WorkingDirectory=/home/ramon/URA
User=ramon
Group=ramon
Restart=always
RestartSec=5
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
