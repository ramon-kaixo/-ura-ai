[Unit]
Description=URA Ejecutor API
After=network.target
Wants=network.target

[Service]
Type=simple
User=ramon
WorkingDirectory=/home/ramon/URA/ura_ia_1972
ExecStartPre=/bin/sleep 30
ExecStart=/usr/bin/python3 /home/ramon/URA/ura_ia_1972/scripts/pro/ejecutor_api.py
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
MemoryHigh=1G
MemoryMax=1.5G

[Install]
WantedBy=multi-user.target
