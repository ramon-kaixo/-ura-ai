// OpenCode Configuration — Mac (Interfaz pura)
// El Mac NUNCA ejecuta modelos. Todo va al GX10 (Ollama) vía túnel SSH.
// Ejecución de scripts: remota vía SSH (rama) o local ligera (nunca LLM).
//
// Instalación (Mac):
//   cp deploy/opencode_mac_config.jsonc ~/.config/opencode/opencode.json  (renombrar, JSON)
//   Requiere el túnel: ~/Library/LaunchAgents/com.ura.ollama-tunnel-gx10.plist
//     (ssh -L 11436:localhost:11434 → Ollama del GX10, RAM siempre ASUS)
//
// NOTA (2026-08-13): el Model Router del GX10 (11435) escucha SOLO en
//   127.0.0.1 — no es accesible desde la Mac. El mecanismo real es el túnel
//   com.ura.ollama-tunnel-gx10 (localhost:11436 = Ollama GX10).

{
  "$schema": "https://opencode.ai/config.json",

  // Modelo: Ollama del GX10 vía túnel local (localhost:11436)
  "model": "ollama/qwen2.5-coder:14b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama GX10 (tunnel)",
      "options": { "baseURL": "http://localhost:11436/v1" },
      "models": {
        "qwen2.5-coder:14b": { "tools": true, "limit": { "context": 65536, "output": 8192 } },
        "qwen3-coder:30b": { "tools": true, "limit": { "context": 65536, "output": 8192 } },
        "deepseek-r1:14b": { "tools": true, "limit": { "context": 65536, "output": 8192 } }
      }
    }
  },

  // Agentes: solo edición de código local, NUNCA ejecución de modelos
  "agent": {
    "default": "ura_router",
    "workspace": "~/URA/ura_ia_1972",
    "executor": "remote",
    "executor_remote": {
      "host": "10.164.1.99",
      "user": "ramon",
      "sandbox": "mejora-continua",
      "command": "docker exec -i ura-mejora-continua"
    }
  },

  // MCP: OpenClaw Gateway en GX10 (localhost allí)
  "mcp": {
    "openclaw": {
      "type": "remote",
      "command": ["ssh", "ramon@10.164.1.99", "openclaw", "mcp", "serve"],
      "enabled": false,
      "timeout": 30000
    }
  },

  // NO usar modelos locales en Mac
  "features": {
    "local_models": false,
    "context_cache": true,
    "cache_ttl": 3600
  }
}